/// Was: UplatniRacuni
model PaymentAccount {
  companyId     Int             @default(0) @map("company_id")
  id            Int             @id(map: "pk_payment_accounts") @default(autoincrement()) @map("id")
  accountNumber String          @map("account_number") @db.VarChar(50)
  bankName      String?         @map("bank_name") @db.VarChar(50)
  isDefault     Boolean         @default(false) @map("is_default")
  sortOrder     Int             @default(0) @map("sort_order") @db.SmallInt
  countryCode   String?         @map("country_code") @db.VarChar(20)
  bankCode      String?         @map("bank_code") @db.VarChar(20)

  // — Bankarske instrukcije za ino fakturu (blok na dnu Invoice 228/25 i na zasebnoj strani 060/26).
  //   Domaća faktura ovaj blok NEMA — ona nosi samo `accountNumber` („Tekući račun: 160-110610-83")
  //   u zaglavlju. Do sada su ova polja postojala samo kao tip u štampi (IssuerInfo.iban/swift) i
  //   nikad se nisu punila, pa se blok banke nije štampao uopšte.

  /// IBAN deviznog računa — red `IBAN :` u koloni „Beneficiary Customer:". ISO 13616, max 34 znaka.
  iban        String? @map("iban") @db.VarChar(34)
  /// SWIFT/BIC banke — red `SWIFT:` u koloni „Bank of beneficiary:". BIC je 8 ili 11 znakova.
  swift       String? @map("swift") @db.VarChar(11)
  /// Adresa banke ispod njenog naziva, višered („Milentija Popovića 7b, 11070 New Belgrade" +
  /// „Republic of Serbia") — prelama se po \n, zato Text a ne VarChar kao ostale adrese.
  bankAddress String? @map("bank_address") @db.Text
  /// Valuta računa — štampa se uz naziv banke („Banca Intesa a.d. EUR") i po njoj se bira koji se
  /// devizni račun uzima za valutu fakture. Ista dužina kao Invoice.currency.
  currency    String? @map("currency") @db.VarChar(3)

  self          PaymentAccount  @relation("PaymentAccountSelf", fields: [id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payment_accounts_self")
  selfReverse   PaymentAccount? @relation("PaymentAccountSelf")

  @@map("payment_accounts")
}

