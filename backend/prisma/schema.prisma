/// Akciona tačka („akcioni plan") — NAJVEĆA tabela domena sastanaka.
/// Was: sy15 `public.akcioni_plan`.
/// status: otvoren | u_toku | zavrsen | kasni | odlozen | otkazan
/// prioritet: 1 (visok) | 2 (srednji) | 3 (nizak)
model AkcionaTacka {
  id               String    @id(map: "pk_akcioni_plan") @default(uuid(4)) @map("id") @db.Uuid
  sastanakId       String?   @map("sastanak_id") @db.Uuid
  temaId           String?   @map("tema_id") @db.Uuid
  /// Predmet (3.0 `projects.id`) — v. prenosnu odluku 2.
  projectId        Int?      @map("projekat_id")
  rb               Int?      @map("rb")
  naslov           String    @map("naslov")
  opis             String?   @map("opis")
  odgovoranEmail   String?   @map("odgovoran_email") @db.VarChar(255)
  odgovoranLabel   String?   @map("odgovoran_label")
  /// Slobodan tekst kad odgovorni nije nalog (spoljni saradnik, odeljenje…).
  odgovoranText    String?   @map("odgovoran_text")
  rok              DateTime? @map("rok") @db.Date
  rokText          String?   @map("rok_text")
  status           String    @default("otvoren") @map("status") @db.VarChar(20)
