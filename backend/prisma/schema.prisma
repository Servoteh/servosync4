/// Registar idempotencije CELE 3.0 aplikacije — 3.0 parnjak sy15 `rev_api_idempotency`
/// (koji uprkos `rev_` prefiksu nikad nije bio samo za reverse: 643 reda, 35 različitih
/// `action` vrednosti iz kadrovske, profila, sastanaka, PB-a i održavanja).
/// Zato je ovde ime GENERIČKO — koriste ga i preostali koraci gašenja sy15
/// (docs/PLAN_GASENJA_SY15_2026-08-03.md), ne samo sastanci.
///
/// ČEMU SLUŽI: dupli POST (dupli klik, retry posle mrežnog prekida) ne sme da napravi
/// drugi sastanak / drugi talas mejlova. Klijent šalje `clientEventId`; prvi zahtev ga
/// upiše i sačuva odgovor, ponovljeni dobija SAČUVAN odgovor bez izvršavanja.
///
/// 🔴 KLJUČNO SVOJSTVO: upis ključa i sama akcija idu u ISTOJ transakciji, pa rollback
/// akcije briše i ključ → neuspeo pokušaj sme da se ponovi. Zato ovde NEMA `@@unique`
/// preko više kolona: PK je sam `client_event_id`, kao u sy15, da bi konkurentan isti
/// ključ ČEKAO na speculative-insert bravi dok prva transakcija ne završi.
///
/// RAZLIKE OD sy15 IZVORA (obe merene, obe namerne):
///  1. `actor_email` — sy15 ga NEMA, pa ponovljen zahtev vraća sačuvan odgovor BILO KOME
///     ko zna ključ. Ovde se pri ponavljanju traži i isti akter, inače 409. Praktično
///     neiskoristivo u sy15 (ključ je nasumičan uuid), ali odgovor ume da nosi tuđe
///     podatke, pa je zatvoreno bez troška.
///  2. TTL — sy15 NEMA čišćenje (izmereno: 0 pg_cron poslova, 0 trigera; najstariji red
///     je od 10.07.2026, tj. od dana nastanka registra, i nikad ništa nije obrisano).
///     Registar je po prirodi kratkotrajan (dedup prozor je minut, ne mesec), pa ga
///     `RetentionJobsService` čisti; zato indeks po `created_at`.
/// STARI ZAPISI SE NE MIGRIRAJU sa sy15 — v. runbook §7c blokada 1.
model ApiIdempotency {
  /// Ključ koji šalje klijent (uuid). PK — namerno bez `action` u ključu: isti
  /// `clientEventId` upotrebljen za DRUGU akciju je greška klijenta i vraća 409.
  clientEventId String   @id(map: "pk_api_idempotency") @map("client_event_id") @db.Uuid
  /// Logičko ime radnje (`sastanci.create-sastanak`, `kadr.grid.batch`…) — isti
  /// prostor imena kao u sy15 registru, da prelaz ne menja ugovor prema klijentu.
  action        String   @map("action") @db.VarChar(100)
  /// Mejl iz sesije onoga ko je ključ potrošio (v. razliku 1 iznad).
  actorEmail    String   @map("actor_email") @db.VarChar(255)
  /// Sačuvan odgovor prvog izvršenja — vraća se na ponovljen zahtev BEZ izvršavanja.
  /// NULL znači „ključ zauzet, izvršenje još traje ili je palo" (upisuje se na kraju).
  result        Json?    @map("result")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "idx_api_idempotency_created")
  @@map("api_idempotency")
}

/// App-owned prekidač za pozadinske poslove koje korisnik sme da ugasi iz Podešavanja
/// (stavka B, 26.07.2026). Ključ je stabilan string (npr. `bigbit_mdb_sync`), stanje živi
/// u bazi — menja se BEZ restarta i BEZ env promenljive. Tabela NIJE u SYNC_MAP i nijedan
/// sync je ne dira (za razliku od `system_config` / `global_config`, koje full_refresh briše).
/// Semantika: red koji NE postoji = uključeno (prekidač je OFF-prekidač; nedostatak reda ne
/// sme tiho da ugasi noćni uvoz). Vidi `podesavanja/sync-switch.service.ts`.
model AppSwitch {
  key             String   @id(map: "pk_app_switches") @map("key") @db.VarChar(64)
  enabled         Boolean  @default(true) @map("enabled")
  /// Podešavanja koja nisu DA/NE nose vrednost ovde (npr. princip vrednovanja KEP
  /// knjige: "MP" ili "VP"). Prekidači je ostavljaju praznu i koriste samo `enabled`.
  value           String?  @map("value") @db.VarChar(64)
  /// Zašto je ugašen/upaljen — slobodan tekst koji admin upiše uz preklop (vidi se na ekranu).
  note            String?  @map("note")
  updatedByUserId Int?     @map("updated_by_user_id")
  /// Denormalizovan email onoga ko je poslednji menjao (kao `audit_log.actorUsername`).
  updatedByEmail  String?  @map("updated_by_email") @db.VarChar(200)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("app_switches")
}

// ============================================================================
// TRAG ŠTAMPE (27.07.2026) — `document_prints`
// ----------------------------------------------------------------------------
// ZAŠTO POSTOJI: do sada je trag štampe živeo SAMO kao tekst u nozi papira
// („Štampao: X · datum · ServoSync 4.0", doc-layout/index.ts) i nigde se nije
// pamtio. Nije se moglo odgovoriti ko je i koliko puta izvadio otpremnicu, niti
// razlikovati original od kopije. BigBit ovo NEMA nigde — ovo je nadgradnja.
//
// KAKO SE DODELJUJE `copyNo`: `pg_advisory_xact_lock(hashtext(...))` UNUTAR
// transakcije, pa MAX+1 u JS-u (isti obrazac kao `BlagajnaService.nextEntryNumber`
// i `StockDocumentNumberingService`). Nikad goli SQL MAX bez lock-a — dva
// istovremena klika na „Štampaj" bi dobila isti broj primerka.
// ============================================================================

/// Jedan red = jedno izvađenje jednog obrasca jednog dokumenta. `copyNo = 1` je original,
/// `>= 2` nosi žig „KOPIJA" na papiru.
///
/// RAST I RETENCIJA (traženo uz zadatak): red je ~120 B, a realan obim Servoteha je reda
/// nekoliko stotina štampi dnevno → ~10–20 MB godišnje. Zato SE NE BRIŠE ništa: tabela je
/// dokazni trag i njena vrednost je upravo u tome što je potpuna. Ako obim ikada naraste,
/// SME se arhivirati SAMO po starosti (`printed_at < now() - N godina`) i NIKAD po dokumentu:
/// brisanje redova jednog dokumenta bi oborilo MAX(copyNo) i sledeća štampa bi se lažno
/// predstavila kao original. Za brzo čitanje su tri indeksa:
///   - `uq_document_prints_copy`  — ključ primerka; ujedno brana od duplog copyNo;
///   - `idx_document_prints_document` — „koliko puta je štampan dokument N" (poziv sa svake štampe);
///   - `idx_document_prints_at`  — pretraga/retencija po datumu („ko je juče štampao").
model DocumentPrint {
  id Int @id(map: "pk_document_prints") @default(autoincrement()) @map("id")

  /// STOCK | INVENTORY_COUNT | INVOICE | PURCHASE_ORDER | GL_JOURNAL | CASH_JOURNAL …
  /// (vidi `DOCUMENT_PRINT_KIND` u documents/document-print.service.ts — jedan izvor istine).
  documentKind String @map("document_kind") @db.VarChar(30)
  /// Meki ref — bez `@relation`, jer tabela pokriva više modula (BACKEND_RULES §5).
  documentId   Int    @map("document_id")
  /// Obrazac unutar dokumenta (`otpremnica`, `kalkulacija`, `popunjena`…). NOT NULL sa default ''
  /// NAMERNO: u Postgresu se NULL-ovi u UNIQUE indeksu tretiraju kao različiti, pa bi nullable
  /// kolona propustila duplikate `copyNo` i značka „KOPIJA" se ne bi nikad pojavila.
  variant      String @default("") @map("variant") @db.VarChar(30)
  /// 1 = original, >= 2 = kopija.
  copyNo       Int    @map("copy_no")

  printedByUserId Int?     @map("printed_by_user_id") // meki ref users.id; NULL = sistemska/batch štampa
  /// Snimak imena u trenutku štampe — `users` je sync-keš, ime se sme promeniti, papir ne sme.
  printedByName   String?  @map("printed_by_name") @db.VarChar(100)
  printedAt       DateTime @default(now()) @map("printed_at") @db.Timestamptz(6)
  companyId       Int      @default(0) @map("company_id")

  @@unique([documentKind, documentId, variant, copyNo], map: "uq_document_prints_copy")
  @@index([documentKind, documentId], map: "idx_document_prints_document")
  @@index([printedAt], map: "idx_document_prints_at")
  @@map("document_prints")
}

// ============================================================================
// BIGBIT .mdb NOĆNI UVOZ (stavka A, 26.07.2026)
// ----------------------------------------------------------------------------
// ZAŠTO POSTOJI: finansijsko jezgro BigBita (glavna knjiga, nalozi, kontni plan,
// PDV šeme) NE POSTOJI u MSSQL izvoru koji vozi `sync-map.generated.ts` — ono
// živi isključivo u Access .mdb fajlu koji se noću spušta u /srv/bigbit-incoming/.
// Bez tih podataka nema tri paralelna PDV obračuna (odluka vlasnika 26.07.2026).
//
// KANAL JE DVOSTEPEN, jer backend kontejner NE VIDI .mdb (proveren 26.07.2026:
// `docker inspect servosync-backend` → Binds=[], nema /var/run/docker.sock, nema
// mdbtools u imidžu). Zato:
//   1) `backend/scripts/bigbit-mdb-export.sh` radi NA HOSTU (ubuntusrv): uzme
//      najnoviji .mdb, izveze tabele kroz `mdbtools:local` i `\copy`-ra ih u
//      `bb_mdb_stage_*` tabele OVE baze, pa upiše red u `bb_mdb_drops`.
//   2) Scheduler posao `bigbit-mdb-import` (sync/bigbit-mdb-import.service.ts)
//      čita staging iz baze i idempotentno ga preslikava u 4.0 modele.
// Postgres je time JEDINI dodirni kanal između hosta i kontejnera — nije potrebna
// nijedna izmena imidža, compose fajla ni mrežnih prava.
//
// NIJE dirano: MSSQL sync (`SyncService` + `SYNC_MAP`) radi nezavisno i dalje.
// ============================================================================

/// Jedan .mdb drop = jedan snimak BigBita. Nosi identitet fajla (ime+mtime+veličina),
/// meru oba koraka (staging na hostu, uvoz iz scheduler-a) i služi kao OZNAKA POREKLA:
/// svaki uvezeni red u 4.0 tabelama nosi `imported_drop_id` → tačno se zna iz kog fajla
/// je došao. `imported_drop_id IS NULL` = red je nastao u 4.0 (nativni unos).
model BbMdbDrop {
  id Int @id(map: "pk_bb_mdb_drops") @default(autoincrement()) @map("id")

  /// Identitet fajla — isto ime + isti mtime + ista veličina = ISTI drop (idempotencija
  /// koraka 1). sha256 se čuva kao dokaz sadržaja, ali NIJE ključ: Access fajl nije
  /// bajt-stabilan pa bi ponovni izvoz istih podataka dao drugi heš.
  fileName   String   @map("file_name") @db.VarChar(255)
  fileMtime  DateTime @map("file_mtime") @db.Timestamptz(6)
  fileSize   BigInt   @map("file_size")
  fileSha256 String?  @map("file_sha256") @db.VarChar(64)

  /// PENDING | LOADED | FAILED — stanje koraka 1 (mdbtools izvoz + \copy u staging).
  stageStatus     String    @default("PENDING") @map("stage_status") @db.VarChar(10)
  stagedAt        DateTime? @map("staged_at") @db.Timestamptz(6)
  stageDurationMs Int?      @map("stage_duration_ms")
  /// { "T_Glavna knjiga": 20366, ... } — broj PARSIRANIH redova po tabeli.
  /// Nikad iz `mdb-count` (greši za -9 na GK) ni iz `wc -l` (memo polja nose \r\n).
  stageRowCounts  Json?     @map("stage_row_counts")
  stageError      String?   @map("stage_error")

  /// PENDING | DONE | FAILED — stanje koraka 2 (staging → 4.0 modeli).
  importStatus     String    @default("PENDING") @map("import_status") @db.VarChar(10)
  /// MUTEX uvoza. Claim je atomski CAS nad ovom kolonom, jer scheduler-ov guard
  /// („svež RUNNING mlađi od 10 min") ne pokriva uvoz koji traje duže od 10 min.
  /// Stariji od IMPORT_LOCK_STALE_HOURS = zaostao posle pada, sme da se preotme.
  importStartedAt  DateTime? @map("import_started_at") @db.Timestamptz(6)
  importedAt       DateTime? @map("imported_at") @db.Timestamptz(6)
  importDurationMs Int?      @map("import_duration_ms")
  /// { "ledger_entries": { "inserted": 20366, "updated": 0, "skipped": 0, "ms": 8123 }, ... }
  importRowCounts  Json?     @map("import_row_counts")
  importError      String?   @map("import_error")

  note      String?  @map("note")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts           Account[]
  orderTypes         OrderType[]
  saldakontoAccounts SaldakontoAccount[]
  journalEntries     JournalEntry[]
  ledgerEntries      LedgerEntry[]
  goodsDocuments     GoodsDocumentMirror[]
  purchaseOrders     PurchaseOrderMirror[]

  stageGk         BbMdbStageGk[]
  stageNalozi     BbMdbStageNalog[]
  stageAccounts   BbMdbStageAccount[]
  stageOrderTypes BbMdbStageOrderType[]
  stageSaldakonto BbMdbStageSaldakonto[]
  stageScheme     BbMdbStageScheme[]
  stageSchemeLine BbMdbStageSchemeLine[]
  stagePdvGk      BbMdbStagePdvGk[]
  stagePopdvGk    BbMdbStagePopdvGk[]
  stageKomitenti  BbMdbStageKomitent[]
  stagePredmeti   BbMdbStagePredmet[]
  stageGrupe      BbMdbStageGrupa[]
  stagePodgrupe   BbMdbStagePodgrupa[]
  stagePoreklo    BbMdbStagePoreklo[]
  stageMagacini   BbMdbStageMagacin[]
  stageArtikli    BbMdbStageArtikal[]

  stageRobnaDokumenta   BbMdbStageRobniDokument[]
  stageRobneStavke      BbMdbStageRobnaStavka[]
  stageTrebovanja       BbMdbStageTrebovanje[]
  stageTrebovanjaStavke BbMdbStageTrebovanjeStavka[]

  @@unique([fileName, fileMtime, fileSize], map: "uq_bb_mdb_drops_file")
  @@index([stageStatus, importStatus], map: "idx_bb_mdb_drops_status")
  @@map("bb_mdb_drops")
}

// ── STAGING (`bb_mdb_stage_*`) ───────────────────────────────────────────────
// Sve kolone su TEXT, NAMERNO. `mdb-export` daje tekst; tipizacija se radi u
// koraku 2 gde neispravan red može da se PRESKOČI uz poruku u dnevniku, umesto
// da obori ceo `\copy` i time i uvoz koji nema veze s njim. Staging je i jedini
// primerak „zlatnog uzorka" (T_PDV_GK / T_POPDV_GK) — BigBitov izlaz PDV motora
// koji se poredi sa našim izračunom, a NE uvozi se u produkcione modele.

/// Was: T_Glavna knjiga — sirov staging (svih 30 izvornih kolona).
model BbMdbStageGk {
  id     Int @id(map: "pk_bb_mdb_stage_gk") @default(autoincrement()) @map("id")
  dropId Int @map("drop_id")

  stavkaId        String? @map("stavka_id") // StavkaID
  konto           String? @map("konto") // Konto
  inoKonto        String? @map("ino_konto") // InoKonto (mrtvo: 0 na 100% redova)
  analitickaSifra String? @map("analiticka_sifra") // Analiticka sifra (= šifra komitenta)
  brojDokumenta   String? @map("broj_dokumenta") // Broj dokumenta (SADRŽI ZAREZ — otud razdvajač pipe)
  datumDokumenta  String? @map("datum_dokumenta") // Datum dokumenta
  valutaDokumenta String? @map("valuta_dokumenta") // Valuta dokumenta (= dospeće, NIJE valuta novca!)
  datumKnjizenja  String? @map("datum_knjizenja") // Datum knjizenja
  idNaloga        String? @map("id_naloga") // IDNaloga (FK T_Nalozi)
  opisDokumenta   String? @map("opis_dokumenta") // Opis dokumenta
  duguje          String? @map("duguje") // Duguje (592 reda NEGATIVNO — vidi relaksiran CHECK)
  potrazuje       String? @map("potrazuje") // Potrazuje
  povezan         String? @map("povezan") // Povezan (0 na 100% — uparivanje se PRERAČUNAVA)
  idDokIzRobnog   String? @map("id_dok_iz_robnog") // IDDokIzRobnog
  temeljnica      String? @map("temeljnica") // Temeljnica
  devDuguje       String? @map("dev_duguje") // DevDuguje (NIJE FX kad je DevValuta=RSD!)
  devPotrazuje    String? @map("dev_potrazuje") // DevPotrazuje
  devValuta       String? @map("dev_valuta") // DevValuta (9 varijanti — normalizuje se)
  pozicija        String? @map("pozicija") // Pozicija (NIJE mesto troška — poreklo dokumenta)
  idDokMp         String? @map("id_dok_mp") // IDDokMP
  idProdavnicaMp  String? @map("id_prodavnica_mp") // IDProdavnicaMP
  idPredmet       String? @map("id_predmet") // IDPredmet
  idDokIzUsluga   String? @map("id_dok_iz_usluga") // IDDokIzUsluga (mrtvo)
  pgIdDokIzRobnog String? @map("pg_id_dok_iz_robnog") // PG_IDDokIzRobnog
  oj              String? @map("oj") // OJ (mrtvo)
  potpis          String? @map("potpis") // Potpis
  datumIVreme     String? @map("datum_i_vreme") // DatumIVreme (watermark, 100% popunjen)
  od              String? @map("od") // OD (mrtvo)
  idRadniNalog    String? @map("id_radni_nalog") // IDRadniNalog (mrtvo)
  pnbOdobBrojGk   String? @map("pnb_odob_broj_gk") // PNBOdobBrojGK

  drop BbMdbDrop @relation(fields: [dropId], references: [id], onDelete: Cascade, map: "fk_bb_mdb_stage_gk_drop")

  @@index([dropId], map: "idx_bb_mdb_stage_gk_drop")
  @@map("bb_mdb_stage_gk")
}

/// Was: T_Nalozi — zaglavlje naloga (staging).
model BbMdbStageNalog {
  id     Int @id(map: "pk_bb_mdb_stage_nalozi") @default(autoincrement()) @map("id")
  dropId Int @map("drop_id")

  idFirma        String? @map("id_firma") // IDFirma (0 na 100%)
  idNaloga       String? @map("id_naloga") // IDNaloga
  brojNaloga     String? @map("broj_naloga") // Broj naloga
  vrstaNaloga    String? @map("vrsta_naloga") // Vrsta naloga
  datumNaloga    String? @map("datum_naloga") // Datum naloga
  opisNaloga     String? @map("opis_naloga") // Opis naloga (Memo)
  datumKnjizenja String? @map("datum_knjizenja") // Datum knjizenja
  level          String? @map("level") // Level
  zakljucano     String? @map("zakljucano") // Zakljucano
  godina         String? @map("godina") // Godina (= FAJL; jedan .mdb = jedna godina)
  potpis         String? @map("potpis") // Potpis
  datumIVreme    String? @map("datum_i_vreme") // DatumIVreme
  stariId        String? @map("stari_id") // STARIID

  drop BbMdbDrop @relation(fields: [dropId], references: [id], onDelete: Cascade, map: "fk_bb_mdb_stage_nalozi_drop")

  @@index([dropId], map: "idx_bb_mdb_stage_nalozi_drop")
  @@map("bb_mdb_stage_nalozi")
}

/// Was: Kontni plan — staging.
