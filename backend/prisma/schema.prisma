  notStockTracked       Boolean?  @default(false) @map("not_stock_tracked")
  weightKg              Float?    @default(0) @map("weight_kg")
  volume                Float?    @default(0) @map("volume")
  area                  Float?    @default(0) @map("area")
  sortOrder             Int?      @default(0) @map("sort_order")
  promotionDiscount     Float?    @default(0) @map("promotion_discount")
  note2                 String?   @map("note_2") @db.VarChar(255)
  qualityTypeId         Int?      @default(0) @map("quality_type_id")
  thickness             Float?    @default(0) @map("thickness")
  externalItemId        Int       @default(0) @map("external_item_id")

  /// Vreme poslednje izmene IZ 4.0 (do 28.07.2026 artikal je imao samo
  /// `createdAt`, pa `PATCH` nije ostavljao trag u vremenu). NULL = nikad menjan
  /// iz 4.0 — BigBit izmene stižu kroz sync i ovo polje ne diraju.
  updatedAt DateTime? @map("updated_at") @db.Timestamp(6)
  /// Ko je poslednji menjao artikal iz 4.0 (`auditName`). Razlikuje se od
  /// `signature` (BigBit `PotpisArt`).
  updatedBy String?   @map("updated_by") @db.VarChar(50)

  /// OZNAKA POREKLA (20260728170000) — isti obrazac i isti default kao
  /// `Customer.source`. `externalItemId` NIJE dovoljan: 1.417 od 92.511 BigBit
  /// artikala na produkciji ima `external_item_id = 0`.
  /// DB brana `chk_items_native_id_range`: `NATIVE` ⇔ `id >= 900000000`.
  source String @default("BIGBIT") @map("source") @db.VarChar(10)

  priceListEntries        PriceListEntry[]
  workOrderItemComponents WorkOrderItemComponent[]

  // SQL-only trigram GIN indeksi (20260726160000): idx_items_name_trgm i
  // idx_items_catalog_number_trgm nad `immutable_unaccent(lower(...))` —
  // 92k redova, pretraga bez kvačica (alat `nadji_artikal`, kasnije i UI).
  //
  // BigBit „Pregled artikala" sortira ORDER BY Grupa, Kataloski broj, Naziv, a
  // filter po grupi je najčešći ulaz u listu (20260805100000). Kolone prate
  // `orderBy` iz `masters/items.service.ts` DOSLOVNO — bez `name` u indeksu
  // planer i dalje dosortira (incremental sort). `id` je tie-breaker za stabilnu
  // paginaciju. Pomaže nefiltriranom pregledu i filteru po grupi; pretraga po
  // nazivu / kat. broju ide na trigram GIN i ne koristi ovaj indeks.
  @@index([groupCode, catalogNumber, name, id], map: "idx_items_group_catalog")
  @@map("items")
}

