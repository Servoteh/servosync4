/// Jedan red po LLM pozivu (chat, STT, refine, embed, naslov, trijaža, rezime…).
/// Upisuje ga `AiUsageService` iz gateway-a — nijedan pozivalac ne piše ovde
/// direktno. Ujedno je izvor za dnevne token-limite (AiLimitsService).
/// module: chat | stt | refine | embed | title | zahtevi-triage | zahtevi-analysis
///         | sastanci-summary | montaza-izvestaj (String, ne enum — BACKEND_RULES §2)
/// outcome: ok | error | fallback
model AiUsageLog {
  id               Int      @id(map: "pk_ai_usage_log") @default(autoincrement()) @map("id")
  userId           Int?     @map("user_id") // null = sistemski poziv (scheduler, fire-and-forget trijaža)
  module           String   @map("module") @db.VarChar(40)
  provider         String   @map("provider") @db.VarChar(20) /// openai | anthropic
  model            String   @map("model") @db.VarChar(80)
  /// PUN ulaz (svež + keširan). Za STT nosi AUDIO tokene iz odgovora — iz njih se
  /// izvodi stvarno trajanje snimka; null kad provajder ne vrati `usage`.
  tokensIn         Int?     @map("tokens_in")
  tokensOut        Int?     @map("tokens_out")
  /// Deo `tokens_in` naplaćen po keš-čitaj ceni (~0,1× ulazne) — samo Anthropic.
  tokensCacheRead  Int?     @map("tokens_cache_read")
  /// Deo `tokens_in` naplaćen po keš-upis ceni (1,25× ulazne, 5-min TTL).
  tokensCacheWrite Int?     @map("tokens_cache_write")
  durationMs       Int      @map("duration_ms") // trajanje poziva, ne dužina audija
  outcome          String   @map("outcome") @db.VarChar(10)
  estCostUsd       Decimal? @map("est_cost_usd") @db.Decimal(10, 6) // null kad cena modela nije poznata
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, module, createdAt], map: "idx_ai_usage_log_user_module_created")
  @@index([createdAt], map: "idx_ai_usage_log_created")
  @@index([module, createdAt], map: "idx_ai_usage_log_module_created")
  @@map("ai_usage_log")
}

/// Diktafon „sanduče" (scenario B — telefon diktira, Claude povlači). Telefon u
/// pogonu diktira srpski (STT + doterivanje), a sređen TEKST se ovde ODLAŽE; Claude
/// Code na Windows radnoj stanici ga POVLAČI read-only preko infra pristupa (SSH →
/// `docker exec servosync-pg psql -U servosync`) i markira `delivered_at` istim
/// kanalom — Claude NE koristi JWT/HTTP. Pull MORA nositi `user_id` filter (Nenad = 2):
///   SELECT id, text FROM dictation_inbox WHERE user_id = 2 AND delivered_at IS NULL
///   ORDER BY created_at DESC LIMIT 1;  -- pa UPDATE … SET delivered_at=now() WHERE id=<row_id>
/// ⚠ Bez `user_id` filtera vraća TUĐI diktat (svaki ai.chat nalog piše ovde; baza bez
/// RLS) = prompt-injection vektor. `GET /dictation-inbox/latest` je za samu aplikaciju.
/// Piše ga ISKLJUČIVO DictationInboxService (V1: samo insert; nema edit/delete).
/// App-owned → Timestamptz(6); `user_id` = users.id iz JWT-a. App rola = `servosync_app`
/// (nextval radi preko default privilegija na `public`; NAMERNO bez eksplicitnog GRANT-a).
/// Čuva se SAMO tekst posle transkripcije — audio snimak se odbacuje, ne ulazi ovde.
model DictationInbox {
  id          Int       @id(map: "pk_dictation_inbox") @default(autoincrement()) @map("id")
  userId      Int       @map("user_id")
  text        String    @map("text") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// null = još nepreuzeto; NON-null = Claude povukao i markirao (idempotentni „latest").
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  /// users.id naloga koji je red POVUKAO kroz `POST /v1/dictation-inbox/claim` (02.08.2026).
  /// null = ili još nepreuzeto, ili preuzeto STARIM putem (ručni psql `UPDATE … delivered_at`).
  /// Nosi oporavak: `GET /v1/dictation-inbox/last-claimed` vraća samo redove sa ovim
  /// nalogom, pa izgubljen HTTP odgovor ne znači trajno izgubljen diktat.
  claimedByUserId Int?  @map("claimed_by_user_id")

  @@index([userId, deliveredAt, createdAt], map: "idx_dictation_inbox_user_delivered_created")
  @@index([claimedByUserId, deliveredAt], map: "idx_dictation_inbox_claimed_by_delivered")
  @@map("dictation_inbox")
}

/// Delegacija diktafon „sandučeta" (2026-08-02). Vlasnik (`owner_user_id`) dozvoljava
/// DRUGOM nalogu (`delegate_user_id`) da POVUČE njegove diktate kroz
/// `POST /v1/dictation-inbox/claim`.
///
/// ZAŠTO: sanduče puni telefon pod NENADOVIM nalogom, a agent koji radi VAN lokalne
/// mreže (Cursor/Claude u oblaku, pokrenut sa telefona) nema SSH/psql do `servosync-pg`
/// pa diktat mora da uzme preko HTTP-a — pod SVOJIM tokenom, gledajući u TUĐE sanduče.
/// Bez reda u ovoj tabeli `claim` sa tuđim `ownerUserId` vraća 403 (default-deny).
/// Ovo je STROŽE od dosadašnjeg puta: identitet vlasnika više ne visi o ručno
/// otkucanom `user_id = 2` u psql komandi, nego o tokenu + eksplicitnoj dozvoli u bazi.
///
/// App-owned → Timestamptz(6). Piše je ISKLJUČIVO admin (`settings.users`) ili DBA SQL-om.
/// Bez FK na `users` — namerno, paritet sa `dictation_inbox` (isti modul, ista migracija-doktrina).
model DictationDelegate {
  id              Int      @id(map: "pk_dictation_delegates") @default(autoincrement()) @map("id")
  /// users.id vlasnika sandučeta (čiji se diktati povlače).
  ownerUserId     Int      @map("owner_user_id")
  /// users.id naloga kome je povlačenje dozvoljeno (agent u oblaku).
  delegateUserId  Int      @map("delegate_user_id")
  /// users.id admina koji je dodelio dozvolu; null za redove upisane ručno SQL-om.
  createdByUserId Int?     @map("created_by_user_id")
  /// Slobodna beleška („Cursor agent sa telefona") — čisto za reviziju.
  note            String?  @map("note") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([ownerUserId, delegateUserId], map: "uq_dictation_delegates_owner_delegate")
  @@index([delegateUserId], map: "idx_dictation_delegates_delegate")
  @@map("dictation_delegates")
}

/// Minimalni registar „zadatak → model" (Talas AI-0, stavka 7). NIJE nova
/// paralelna istina: prazan red = fallback na postojeći izvor (sy15
/// sastanci_ai_settings / montaza_ai_settings, odn. env za zahteve i chat).
/// task: chat-claude | sastanci-summary | montaza-izvestaj | zahtevi-triage | zahtevi-analysis
/// effort: low | medium | high | xhigh | max (null = podrazumevani za model)
model AiModelPolicy {
  task      String   @id(map: "pk_ai_model_policy") @map("task") @db.VarChar(40)
  model     String   @map("model") @db.VarChar(80)
  effort    String?  @map("effort") @db.VarChar(10)
  updatedBy String?  @map("updated_by") @db.VarChar(200)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("ai_model_policy")
}

/// Zahtev 038/26: crtež (PDF) za RN koji je mašinska usluga bez PDM crteža —
/// ISTI bytea-u-bazi obrazac kao `PlanProizvodnjeDrawing` (M1, nema object
/// storage). Otpremanje je dozvoljeno na dva ekrana: „radni nalozi" (RN već
/// postoji → `workOrderId`) i primopredaje „na pisanju" PRE nego što RN nastane
/// (`handoverId`, `workOrderId` NULL). Kad kasnije nastane RN iz te primopredaje
/// (`HandoversService.createHandoverWorkOrder` — „Otkucaj TP"/lansiranje), servis
/// backfilluje `workOrderId` na postojeće redove sa `handoverId` = ta primopredaja
/// (isti crtež postaje vidljiv i na RN ekranu). Oba ref-a su MEKI (bez DB FK-a,
/// isti obrazac kao `plan_proizvodnje_drawings.work_order_id`).
model WorkOrderDrawingPdf {
  id          Int       @id(map: "pk_work_order_drawing_pdfs") @default(autoincrement()) @map("id")
  /// Meki ref → work_orders.id. NULL dok RN još ne postoji (vidi handoverId).
  workOrderId Int?      @map("work_order_id")
  /// Meki ref → drawing_handovers.id. Popunjen SAMO za otpremanje sa primopredaje
  /// „na pisanju" pre nego što RN postoji; inače NULL.
  handoverId  Int?      @map("handover_id")
  fileName    String    @map("file_name") @db.VarChar(255)
  contentType String?   @map("content_type") @db.VarChar(100)
  /// PDF sadržaj (bytea, M1 obrazac).
  pdfBinary   Bytes?    @map("pdf_binary")
  sizeBytes   BigInt?   @map("size_bytes")
  uploadedBy  String?   @map("uploaded_by")
  uploadedAt  DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy   String?   @map("deleted_by")

  @@index([workOrderId], map: "idx_work_order_drawing_pdfs_work_order")
  @@index([handoverId], map: "idx_work_order_drawing_pdfs_handover")
  @@map("work_order_drawing_pdfs")
}

// ============================================================================
// SEOBA sy15 — KORAK 1: SASTANCI + PROJEKTNI BIRO (05.08.2026)
// ============================================================================
// Merenje, obrazloženje i runbook: docs/SEOBA_SASTANCI_PB_2026-08-05.md.
// Korak 1 iz docs/PLAN_GASENJA_SY15_2026-08-03.md; obrazac preuzet od pripreme
// reversa (grana feat/sy15-seoba-reversi).
//
// PRENOSNE ODLUKE (sve izmerene, ne pretpostavljene):
//
//  1. UUID PK-ovi se ZADRŽAVAJU 1:1 -> prenos je egzaktno idempotentan (upsert po
//     `id`), bez remap tabele. Odstupanje od BACKEND_RULES §2.1 („ID-jevi nisu
//     UUID") je svesno i ograničeno na preseljene sy15 tabele — isti presedan kao
//     `rev_*`: legacy ključ ostaje ključ.
//  2. `projekat_id`/`project_id` (uuid -> sy15 `public.projects`) postaje **Int FK
//     na 3.0 `projects.id`**. sy15 `projects.id` je DETERMINISTIČKI izveden iz
//     `bigtehn_item_id` (`pb_predmet_project_uuid`: md5('servoteh_pb_predmet:v1:'||id)),
//     a `bigtehn_item_id` JESTE 3.0 `projects.id` — izmereno 22/22 poklapanja i po
//     id-u i po šifri (`project_code` = `project_number`). Jedini nepoklopljeni red
//     je sintetički `PRAC-PROD-TEST` koji nijedan red domena ne referencira.
//  3. Identitet ljudi ostaje **mejl** (tekst, doslovno). Ceo domen je mejl-baziran:
//     PK učesnika je (sastanak_id, email), RSVP/priprema/RLS porede
//     `lower(email) = jwt.email`, primaoci notifikacija su mejlovi (i za ljude bez
//     naloga). Prevođenje u `users.id` bi polomilo i PK i mejl kanal. Mapa
//     identiteta se koristi za AUTORIZACIJU, ne za skladištenje.
//  4. Kolone koje su u sy15 imale FK na `auth.users(id)` (uuid) prevode se u
//     **Int FK na `users.id`** — izmereno 6/6 razrešenih po mejlu.
//  5. `employees.id` (uuid) ostaje **meka veza bez FK-a** (obrazac
//     `KadrGridDayLock`) — kadrovska je korak 4, još je u sy15.
//  6. PG enum tipovi (`pb_task_status`, `pb_task_vrsta`, `pb_prioritet`,
//     `pb_eng_tip_status`) prelaze u **String + CHECK** — BACKEND_RULES §2.2.
//  7. RLS politike se NE prenose (74 politike u sy15) — 3.0 koristi guardove i
//     query-scoping (ODLUKE.md).

/// Sastanak (sedmični/projektni/tematski/dnevni/periodični). Was: sy15 `public.sastanci`.
/// tip: sedmicni | projektni | tematski | dnevni | periodicni
/// status: planiran | u_toku | zavrsen | zakljucan | otkazan
model Sastanak {
  id                  String    @id(map: "pk_sastanci") @default(uuid(4)) @map("id") @db.Uuid
  tip                 String    @default("sedmicni") @map("tip") @db.VarChar(20)
  naslov              String    @map("naslov")
  datum               DateTime  @map("datum") @db.Date
  vreme               DateTime? @map("vreme") @db.Time(6)
  mesto               String?   @default("") @map("mesto")
  /// Predmet (3.0 `projects.id`). U sy15 je bio uuid — v. prenosnu odluku 2.
  projectId           Int?      @map("projekat_id")
  vodioEmail          String?   @map("vodio_email") @db.VarChar(255)
  vodioLabel          String?   @map("vodio_label")
  zapisnicarEmail     String?   @map("zapisnicar_email") @db.VarChar(255)
  zapisnicarLabel     String?   @map("zapisnicar_label")
  status              String    @default("planiran") @map("status") @db.VarChar(20)
  zakljucanAt         DateTime? @map("zakljucan_at") @db.Timestamptz(6)
  zakljucanByEmail    String?   @map("zakljucan_by_email") @db.VarChar(255)
  napomena            String?   @map("napomena")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Mejl kreatora; `auto@sistem` za sastanke koje kuje automat (sast_auto_create_weekly).
  createdByEmail      String?   @map("created_by_email") @db.VarChar(255)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  pozivnicePoslateAt  DateTime? @map("pozivnice_poslate_at") @db.Timestamptz(6)
  zapisnikDatum       DateTime? @map("zapisnik_datum") @db.Date
  /// Period ponavljanja za tip `periodicni` (1..365 dana).
  intervalDays        Int?      @map("interval_days")
  prethodniSastanakId String?   @map("prethodni_sastanak_id") @db.Uuid

  project           Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_sastanci_project")
  prethodniSastanak Sastanak?                @relation("SastanakLanac", fields: [prethodniSastanakId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_sastanci_prethodni")
  /// Prisma vezu drži kao 1:N jer je u sy15 jedinstvenost PARCIJALNA
  /// (`WHERE prethodni_sastanak_id IS NOT NULL`) — to Prisma ne ume izraziti,
  /// pa taj unique ostaje SQL-only u migraciji (stvarna kardinalnost je 1:1).
  sledeciSastanci   Sastanak[]               @relation("SastanakLanac")
  ucesnici          SastanakUcesnik[]
  odluke            SastanakOdluka[]
  arhiva            SastanakArhiva?
  akcije            AkcionaTacka[]
  teme              PmTema[]
  presekAktivnosti  PresekAktivnost[]
  presekSlike       PresekSlika[]
  notifikacije      SastanciNotificationLog[]

  @@index([datum(sort: Desc)], map: "idx_sastanci_datum")
  @@index([projectId], map: "idx_sastanci_projekat")
  // SQL-only: CHECK-ovi (tip/status/interval_days), parcijalni unique
  // `sastanci_prethodni_sastanak_uq` (WHERE prethodni_sastanak_id IS NOT NULL) i
  // funkcijski indeksi nad `lower(...)` mejla — Prisma ih ne ume izraziti.
  @@map("sastanci")
}

/// Učesnik sastanka. PK je (sastanak_id, email) — identitet je MEJL, ne nalog:
/// na sastanak se poziva i neko ko nema nalog u 3.0. Was: sy15 `sastanak_ucesnici`.
/// rsvpStatus: null | dolazim | ne_dolazim
model SastanakUcesnik {
  sastanakId  String    @map("sastanak_id") @db.Uuid
  email       String    @map("email") @db.VarChar(255)
  label       String?   @map("label")
  prisutan    Boolean   @default(true) @map("prisutan")
  pozvan      Boolean   @default(true) @map("pozvan")
  napomena    String?   @map("napomena")
  pripremljen Boolean   @default(false) @map("pripremljen")
  priprema    String?   @map("priprema")
  rsvpStatus  String?   @map("rsvp_status") @db.VarChar(20)
  rsvpAt      DateTime? @map("rsvp_at") @db.Timestamptz(6)
  /// TAJNA magic-linka za RSVP iz mejla — NIKAD se ne vraća kroz API
  /// (`UCESNIK_SELECT` u sastanci.service.ts je izostavlja).
  rsvpToken   String    @default(uuid(4)) @map("rsvp_token") @db.Uuid

  sastanak Sastanak @relation(fields: [sastanakId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sastanak_ucesnici_sastanak")

  @@id([sastanakId, email], map: "pk_sastanak_ucesnici")
  @@unique([rsvpToken], map: "uq_sastanak_ucesnici_rsvp_token")
  @@map("sastanak_ucesnici")
}

/// Odluka doneta na sastanku. Was: sy15 `sastanak_odluke`.
/// status: na_snazi | opozvana
model SastanakOdluka {
  id           String    @id(map: "pk_sastanak_odluke") @default(uuid(4)) @map("id") @db.Uuid
  sastanakId   String    @map("sastanak_id") @db.Uuid
  rb           Int?      @map("rb")
  naslov       String    @map("naslov")
  opis         String?   @map("opis")
  odlucioEmail String?   @map("odlucio_email") @db.VarChar(255)
  odlucioLabel String?   @map("odlucio_label")
  odlukaDatum  DateTime? @map("odluka_datum") @db.Date
  uticaj       String?   @map("uticaj")
  vezaTemaId   String?   @map("veza_tema_id") @db.Uuid
  vezaAkcijaId String?   @map("veza_akcija_id") @db.Uuid
  status       String    @default("na_snazi") @map("status") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  sastanak   Sastanak      @relation(fields: [sastanakId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sastanak_odluke_sastanak")
  vezaTema   PmTema?       @relation(fields: [vezaTemaId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_sastanak_odluke_tema")
  vezaAkcija AkcionaTacka? @relation(fields: [vezaAkcijaId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_sastanak_odluke_akcija")

  @@index([sastanakId], map: "idx_sast_odluke_sastanak")
  @@index([status], map: "idx_sast_odluke_status")
  @@map("sastanak_odluke")
}

/// Arhiva zaključanog sastanka: JSONB snimak + putanja PDF zapisnika u storage-u.
/// `zapisnikStoragePath` pokazuje na sy15 bucket `sastanci-arhiva` — fajlovi se u
/// koraku 1 NE sele (v. runbook §6). Was: sy15 `sastanak_arhiva`.
model SastanakArhiva {
  id                  String    @id(map: "pk_sastanak_arhiva") @default(uuid(4)) @map("id") @db.Uuid
  sastanakId          String    @unique(map: "uq_sastanak_arhiva_sastanak") @map("sastanak_id") @db.Uuid
  snapshot            Json      @map("snapshot")
  zapisnikStoragePath String?   @map("zapisnik_storage_path")
  zapisnikSizeBytes   BigInt?   @map("zapisnik_size_bytes")
  zapisnikGeneratedAt DateTime? @map("zapisnik_generated_at") @db.Timestamptz(6)
  arhiviraoEmail      String?   @map("arhivirao_email") @db.VarChar(255)
  arhiviraoLabel      String?   @map("arhivirao_label")
  arhiviranoAt        DateTime  @default(now()) @map("arhivirano_at") @db.Timestamptz(6)

  sastanak Sastanak @relation(fields: [sastanakId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sastanak_arhiva_sastanak")

  @@index([arhiviranoAt(sort: Desc)], map: "idx_sa_arhivirano_at")
  @@map("sastanak_arhiva")
}

/// Šablon sastanka (iz njega automat kuje termine). Was: sy15 `sastanci_templates`.
/// cadence: weekly | biweekly | monthly | daily | none
model SastanciTemplate {
  id              String    @id(map: "pk_sastanci_templates") @default(uuid(4)) @map("id") @db.Uuid
  naziv           String    @map("naziv")
  tip             String    @map("tip") @db.VarChar(20)
  mesto           String?   @map("mesto")
  vodioEmail      String?   @map("vodio_email") @db.VarChar(255)
  zapisnicarEmail String?   @map("zapisnicar_email") @db.VarChar(255)
  cadence         String    @map("cadence") @db.VarChar(20)
  /// Dan u nedelji 0..6 (0 = nedelja) za weekly/biweekly.
  cadenceDow      Int?      @map("cadence_dow")
  /// Dan u mesecu 1..31 za monthly.
  cadenceDom      Int?      @map("cadence_dom")
  vreme           DateTime? @map("vreme") @db.Time(6)
  napomena        String?   @map("napomena")
  isActive        Boolean   @default(true) @map("is_active")
  createdByEmail  String?   @map("created_by_email") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  ucesnici SastanciTemplateUcesnik[]

  @@map("sastanci_templates")
}

/// Podrazumevani učesnik šablona. Was: sy15 `sastanci_template_ucesnici`.
model SastanciTemplateUcesnik {
  templateId String  @map("template_id") @db.Uuid
  email      String  @map("email") @db.VarChar(255)
