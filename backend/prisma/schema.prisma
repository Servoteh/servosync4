/// Was: R_Grupa / R_Podgrupa / R_Poreklo / Magacini — staging (30.07.2026).
///
/// Preuzeto iz starijeg `bigbit-bridge` mehanizma, koji je baš ove četiri tabele
/// vukao iz .mdb-a — ali mu tajmer nikad nije instaliran, pa nije odradio nijedan
/// prolaz. Hitne su zato što 4.0 za njih ima tri syncera (`syncers/item-group`,
/// `item-subgroup`, `item-origin`) koji čitaju kroz `MssqlClient`, dakle iz
/// QBigTehna — a on je ugašen. Ti synceri su MRTVI ROĐENI: registrovani su i
/// izgledaju živi, a ne mogu doneti nijedan red.
model BbMdbStageGrupa {
  id     Int     @id(map: "pk_bb_mdb_stage_grupe") @default(autoincrement()) @map("id")
  dropId Int     @map("drop_id")
  grupa  String? @map("grupa") // Grupa
  opis   String? @map("opis") // Opis

  drop BbMdbDrop @relation(fields: [dropId], references: [id], onDelete: Cascade, map: "fk_bb_mdb_stage_grupe_drop")

  @@index([dropId], map: "idx_bb_mdb_stage_grupe_drop")
  @@map("bb_mdb_stage_grupe")
}

