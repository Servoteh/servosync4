  saleWithPpp          Boolean? @default(false) @map("sale_with_ppp")
  saleWithPpu          Boolean? @default(true) @map("sale_with_ppu")
  postRetailCharge     Boolean? @default(false) @map("post_retail_charge")
  postRetailDischarge  Boolean? @default(false) @map("post_retail_discharge")
  reportText           String?  @map("report_text") @db.VarChar(50)
  postInVatLedger      Boolean? @default(true) @map("post_in_vat_ledger")
  kepuDefaultCharge    String?  @map("kepu_default_charge") @db.VarChar(30)
  kepuDefaultDischarge String?  @map("kepu_default_discharge") @db.VarChar(30)
  isInternalDocument   Boolean? @default(false) @map("is_internal_document")
  numberingStart       Int?     @default(0) @map("numbering_start")
  isFiscal             Boolean? @default(false) @map("is_fiscal")
  documentNumberPrefix String?  @map("document_number_prefix") @db.VarChar(5)
  defaultWarehouseId   Int?     @default(0) @map("default_warehouse_id")
  isDepartmental       Boolean? @default(false) @map("is_departmental")
  isFr                 Boolean? @default(false) @map("is_fr")
  affectsStock         Boolean? @default(true) @map("affects_stock")

  // ── Registar kao KONFIGURACIJA EKRANA UNOSA (PLAN_UNOS_DOKUMENATA §5.1) ────
  // BigBit nema 57 ekrana za 57 vrsta — ima jedan skelet koji ovaj red konfiguriše.
  // Nova vrsta = nov red ovde, bez izmene frontenda.

  /// Grupa numeracije — više vrsta deli JEDAN godišnji niz (§8/O4.2, izmereno):
  /// INVOICE_OUT (IFR, IFGP, IFUSL, IZVRO, IZVGP, IZVUS) | OFFER (PON, PROF, OTP) |
  /// ADVANCE (AVR) | CREDIT (KNO, KNZ) | PURCHASE …
  /// NAPOMENA: ključ `document_number_sequences` je JOŠ UVEK po vrsti — prebacivanje
  /// na grupu je korak 3 redosleda iz §8/O4.4 i sme tek POSLE uvoza istorije.
  numberingGroup          String?  @map("numbering_group") @db.VarChar(20)
  /// SEQ (brojač) | MAX (prvi slobodan broj iz grupe) | COUNT — oba BigBit mehanizma.
  numberingMode           String?  @map("numbering_mode") @db.VarChar(10)
  /// Profil ekrana: GOODS | SERVICE | ORDER. PREDLOG, ne tvrdo pravilo (§8/O4.5) —
  /// dokument ga prekucava preko `Invoice.lineProfile`.
  screenKind              String?  @map("screen_kind") @db.VarChar(10)
  /// BLOCK | WARN | OFF. Blokira se SAMO ako i magacin vodi zalihe — provera je
  /// konjunkcija dva uslova (§2.7); na ponudi/predračunu je namerno OFF.
  stockCheck              String?  @map("stock_check") @db.VarChar(10)
  /// PROF sa „Rezerviši" — vrsta rezerviše zalihe umesto da ih razduži.
  reservesStock           Boolean  @default(false) @map("reserves_stock")
  /// MP tok: dokument upisuje svoje cene nazad u cenovnik (§4.7).
  writesPriceList         Boolean  @default(false) @map("writes_price_list")
  /// Cenovnik koji vrsta otvara (meki ref na šifru cenovnika).
  defaultPriceListCode    String?  @map("default_price_list_code") @db.VarChar(20)
  /// Podrazumevano poresko oslobođenje (npr. IZVRO → čl. 24 st. 1 tač. 5).
  defaultVatExemptionCode String?  @map("default_vat_exemption_code") @db.VarChar(20)
  requiresProject         Boolean  @default(false) @map("requires_project")
  requiresWorkOrder       Boolean  @default(false) @map("requires_work_order")
  requiresPoNumber        Boolean  @default(false) @map("requires_po_number")
  /// Šifre varijanti štampe koje vrsta nudi (Ctrl+P meni). Prazno = podrazumevana.
  allowedPrintVariants    String[] @default([]) @map("allowed_print_variants")
  /// Dozvoljeni ciljevi prepisa (PON → PROF → AVR → IFR). Prazno = bez prepisa.
  carryOverTargets        String[] @default([]) @map("carry_over_targets")

  // Sve meke reference (price_list, stock_documents, kepu) idu po code — mora biti jedinstven (DB-013).
  @@unique([code], map: "uq_document_types_code")
  @@index([numberingGroup], map: "idx_document_types_numbering_group")
  @@map("document_types")
}

