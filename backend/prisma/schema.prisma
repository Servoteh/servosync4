  @@unique([jobKey, scheduledFor], map: "uq_scheduled_job_runs_job_scheduled")
  @@index([jobKey, startedAt(sort: Desc)], map: "idx_scheduled_job_runs_job_started")
  @@map("scheduled_job_runs")
