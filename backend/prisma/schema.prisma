  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByEmail   String?   @map("created_by_email") @db.VarChar(255)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  sastanak     Sastanak?                @relation(fields: [sastanakId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_akcioni_plan_sastanak")
  tema         PmTema?                  @relation(fields: [temaId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_akcioni_plan_tema")
  project      Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_akcioni_plan_project")
  istorija     AkcionaTackaIstorija[]
  odluke       SastanakOdluka[]
  notifikacije SastanciNotificationLog[]

  @@index([odgovoranEmail], map: "idx_ap_odgovoran")
  @@index([projectId], map: "idx_ap_projekat")
  @@index([rok], map: "idx_ap_rok")
  @@index([sastanakId], map: "idx_ap_sastanak")
  @@index([status], map: "idx_ap_status")
  @@map("akcioni_plan")
}

