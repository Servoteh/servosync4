  project  Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_pm_teme_project")
  sastanak Sastanak?        @relation(fields: [sastanakId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_pm_teme_sastanak")
