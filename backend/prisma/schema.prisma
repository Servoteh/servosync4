/// Was: Komitenti — staging (matični podaci, 30.07.2026).
///
/// ZAŠTO SU MATIČNI PODACI DOŠLI U .mdb KANAL: do 22.07.2026 su komitenti i
/// predmeti stizali kroz MSSQL kopiju `QBigTehn`. Tog dana je prenos iz BigBita
/// u tu kopiju prestao da se radi — mereno 30.07: BigBit na predmetu 10014,
/// QBigTehn i 4.0 na 10005. Dakle 4.0 je bio savršeno usklađen sa svojim
/// izvorom, a izvor je bio mrtav osam dana i to niko nije video. Otud isti
/// kanal kao knjigovodstvo: direktno iz kopije BigBit baze.
///
/// SVE KOLONE SU `String?` (sirov tekst iz CSV-a) — kao i ostale staging tabele.
/// Tipizacija i validacija su posao uvoza, da bajat ili čudan red padne TAMO gde
/// se može imenovati, a ne na `COPY` sa porukom o broju kolone.
model BbMdbStageKomitent {
  id     Int @id(map: "pk_bb_mdb_stage_komitenti") @default(autoincrement()) @map("id")
  dropId Int @map("drop_id")

  sifra                        String? @map("sifra") // Sifra (IDENTITY → customers.id)
  naziv                        String? @map("naziv") // Naziv
  poslovnica                   String? @map("poslovnica") // Poslovnica
  mesto                        String? @map("mesto") // Mesto
  adresa                       String? @map("adresa") // Adresa
  postanskiBroj                String? @map("postanski_broj") // Postanski broj
  ziroRacun1                   String? @map("ziro_racun_1") // Ziro racun_1
  ziroRacun2                   String? @map("ziro_racun_2") // Ziro racun_2
  ziroRacun3                   String? @map("ziro_racun_3") // Ziro racun_3
  telefon                      String? @map("telefon") // Telefon
  fax                          String? @map("fax") // Fax
  kontakt                      String? @map("kontakt") // Kontakt
  napomena                     String? @map("napomena") // Napomena (Memo — nosi CR/LF)
  drzava                       String? @map("drzava") // Drzava
  region                       String? @map("region") // Region
  vrstaSifre                   String? @map("vrsta_sifre") // Vrsta sifre
  email                        String? @map("email") // Email
  mobilni                      String? @map("mobilni") // Mobilni
  datumRodjenja                String? @map("datum_rodjenja") // Datum rodjenja
  webAdresa                    String? @map("web_adresa") // Web adresa
  sifraProdavca                String? @map("sifra_prodavca") // Sifra prodavca
  rabatKomitenta               String? @map("rabat_komitenta") // RabatKomitenta
  zastKodKupca                 String? @map("zast_kod_kupca") // ZastKodKupca
  pib                          String? @map("pib") // PIB (prazan je legitiman — ino kupci ga nemaju)
  pdvStatus                    String? @map("pdv_status") // PDVStatus
  msifra                       String? @map("msifra") // MSifra
  odlozeno                     String? @map("odlozeno") // Odlozeno
  idRuta                       String? @map("id_ruta") // IDRuta
  idVozac                      String? @map("id_vozac") // IDVozac
  idUplatniRacun               String? @map("id_uplatni_racun") // IDUplatniRacun
  fakturisanjePoMestimaIsporuke String? @map("fakturisanje_po_mestima_isporuke") // FakturisanjePoMestimaIsporuke
  cenovnik                     String? @map("cenovnik") // Cenovnik
  prviUnos                     String? @map("prvi_unos") // PrviUnos
  poslednjaIzmena              String? @map("poslednja_izmena") // PoslednjaIzmena (vodeni žig za razliku)
  prviUnosUser                 String? @map("prvi_unos_user") // PrviUnosUser
  poslednjaIzmenaUser          String? @map("poslednja_izmena_user") // PoslednjaIzmenaUser
  procenatProvizije            String? @map("procenat_provizije") // ProcenatProvizije
  fiktRabatKomitenta           String? @map("fikt_rabat_komitenta") // FiktRabatKomitenta
  komitentiNacinPlacanja       String? @map("komitenti_nacin_placanja") // KomitentiNacinPlacanja
  potpisKom                    String? @map("potpis_kom") // PotpisKom
  // ── 17 kolona koje je otkrila brana zaglavlja (30.07.2026) ────────────────
  // Deklaracija je pravljena po starijoj kopiji baze; PRAVA tabela ih nosi.
  // Među njima su GLN, MaticniBroj, JBKJS i CRF — polja od kojih zavisi SEF.
  // Uvoz je do sada mislio da ih .mdb NE donosi i namerno ih je ostavljao na
  // miru; donosi ih, pa se sada mogu i preslikati.
  skraceniNaziv                String? @map("skraceni_naziv") // SkraceniNaziv
  datumIVremeKom               String? @map("datum_i_vreme_kom") // DatumIVremeKom
  proveraDuga                  String? @map("provera_duga") // ProveraDuga
  kreditLimit                  String? @map("kredit_limit") // KreditLimit
  neProveravajPib              String? @map("ne_proveravaj_pib") // NeProveravajPIB
  idPantheon                   String? @map("id_pantheon") // IDPantheon
  newsLetter                   String? @map("news_letter") // NewsLetter
  postaNaDruguAdresu           String? @map("posta_na_drugu_adresu") // PostaNaDruguAdresu
  gln                          String? @map("gln") // GLN — e-faktura
  klRucProc                    String? @map("kl_ruc_proc") // KLRucProc
  napomenaZaSalda              String? @map("napomena_za_salda") // NapomenaZaSalda
  nePrikazatiUPregledu         String? @map("ne_prikazati_u_pregledu") // NePrikazatiUPregledu
  jbkjs                        String? @map("jbkjs") // JBKJS — javni sektor
  maticniBroj                  String? @map("maticni_broj") // MaticniBroj
  erXmlSaPopustomPoArtiklu     String? @map("er_xml_sa_popustom_po_artiklu") // ER_XMLSaPopustomPoArtiklu
  crf                          String? @map("crf") // CRF — centralni registar faktura
  koristiPnbZadModel           String? @map("koristi_pnb_zad_model") // KoristiPNBZadModel

  drop BbMdbDrop @relation(fields: [dropId], references: [id], onDelete: Cascade, map: "fk_bb_mdb_stage_komitenti_drop")

  @@index([dropId], map: "idx_bb_mdb_stage_komitenti_drop")
  @@map("bb_mdb_stage_komitenti")
}

