/// Talas AI-3 — idempotencija + trag dnevnog brifa (docs/PLAN_AI_OS_2026-07.md §5).
/// Jedan red po (dan, primalac): scheduler posao `daily-brief` PRE slanja radi
/// atomski claim `INSERT ... ON CONFLICT (for_date, recipient_email) DO NOTHING` —
/// nema reda znači „već poslato danas" pa se preskače (nema duplog mejla ni uz
/// catch-up/retry). Piše ga ISKLJUČIVO DailyBriefService. App-owned → Timestamptz.
/// status: pending (claim, još nije poslato) | sent | dry_run (RESEND nekonfigurisan).
/// Claim upisuje 'pending'; 'pending'/'dry_run' su re-claim-abilni, 'sent' nije.
model DailyBriefSend {
  id             Int      @id(map: "pk_daily_brief_sends") @default(autoincrement()) @map("id")
  forDate        DateTime @map("for_date") @db.Date
  recipientEmail String   @map("recipient_email") @db.VarChar(255)
  sentAt         DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)
  status         String   @default("pending") @map("status") @db.VarChar(10)
  sectionsCount  Int      @default(0) @map("sections_count")
  itemsCount     Int      @default(0) @map("items_count")

  @@unique([forDate, recipientEmail], map: "uq_daily_brief_sends_date_recipient")
  @@index([forDate], map: "idx_daily_brief_sends_for_date")
  @@map("daily_brief_sends")
}

/// Zaključan dan mesečnog grida (AUDIT-K7c, odluka Nenad 26.07).
///
/// ⚠️ Brava živi u 3.0 bazi, NE u sy15 `work_hours` — ta tabela je deljena sa
/// ŽIVIM 1.0, pa joj se šema ne dira (doktrina). Posledica koju treba znati:
/// dok 1.0 radi paralelno, on piše direktno u sy15 i OVU bravu ne vidi. Brava je
/// puna tek po gašenju 1.0; do tada štiti 3.0 stranu (gde se i radi grid).
///
/// Auto-predlog iz kapije NIJE razlog za ovu bravu — on ionako nikad ne gazi
/// postojeći red (`INSERT … ON CONFLICT DO NOTHING`, grid-autofill.service.ts).
/// Brava je protiv LJUDSKE izmene posle potvrde.
///
/// Otključati sme urednik grida (Nikola) i admin — oni tada smeju i da izmene.
model KadrGridDayLock {
  id         Int      @id(map: "pk_kadr_grid_day_locks") @default(autoincrement()) @map("id")
