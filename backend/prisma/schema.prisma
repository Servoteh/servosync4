  uploadedAt       DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  /// U sy15 je bio `auth.users.id` (uuid); prevedeno na `users.id` (odluka 4).
  uploadedByUserId Int?      @map("uploaded_by")
  uploadedByEmail  String?   @map("uploaded_by_email") @db.VarChar(255)

  task       PbTask @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pb_task_files_task")
  uploadedBy User?  @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_pb_task_files_user")

  // SQL-only: parcijalni indeks `idx_ptf_task_active` (WHERE deleted_at IS NULL).
  @@map("pb_task_files")
}

/// Dnevni izveštaj o radu inženjera. Was: sy15 `pb_work_reports`.
model PbWorkReport {
  id         String   @id(map: "pk_pb_work_reports") @default(uuid(4)) @map("id") @db.Uuid
  /// MEKA veza -> sy15 `employees.id` (uuid) — odluka 5.
  employeeId String?  @map("employee_id") @db.Uuid
  datum      DateTime @map("datum") @db.Date
