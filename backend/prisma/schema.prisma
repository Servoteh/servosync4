/// Talas A: dnevnik izvršavanja zakazanih poslova (scheduler modul). UNIQUE
/// (jobKey, scheduledFor) je i mutex za claim — vidi scheduler.service.ts.
/// status: RUNNING | DONE | FAILED (String, ne enum — BACKEND_RULES §2).
model ScheduledJobRun {
  id           Int       @id(map: "pk_scheduled_job_runs") @default(autoincrement()) @map("id")
  jobKey       String    @map("job_key") @db.VarChar(64)
  scheduledFor DateTime  @map("scheduled_for") @db.Timestamptz(6)
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)
  status       String    @default("RUNNING") @map("status") @db.VarChar(16)
  attempts     Int       @default(1) @map("attempts")
