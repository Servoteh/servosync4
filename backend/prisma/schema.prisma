// ============================================================================
// SEOBA sy15 — KORAK 2: ODRŽAVANJE (CMMS) (06.08.2026)
// ============================================================================
// Merenje, obrazloženje i runbook: docs/SEOBA_ODRZAVANJA_2026-08-06.md.
// Korak 2 iz docs/PLAN_GASENJA_SY15_2026-08-03.md; obrazac preuzet od koraka 1
// (sastanci + PB, docs/SEOBA_SASTANCI_PB_2026-08-05.md).
//
// OBIM (izmereno `count(*)` nad živom sy15, 06.08.2026): **34 tabele, 764 reda**.
// ⚠️ 34, ne 33: `prisma/sy15.prisma` NAMERNO nema model za `maint_wo_number_counter`
// (deny-all RLS, dodela broja isključivo kroz trigger), pa spisak „po modelima"
// promašuje baš tabelu koja nosi BROJAČ RADNIH NALOGA. Bez nje bi numeracija posle
// preklopa krenula od nule i sudarila se sa postojećim brojevima — ista klasa
// previda kao `akcioni_plan_istorija` u koraku 1.
//
// PRENOSNE ODLUKE (sve izmerene, ne pretpostavljene):
//
//  1. UUID PK-ovi se ZADRŽAVAJU 1:1 -> prenos je egzaktno idempotentan (upsert po
//     `id`), bez remap tabele. Isti presedan kao korak 1 i `rev_*`.
//  2. Kolone koje su u sy15 imale FK na `auth.users(id)` (uuid) prevode se u
//     **Int na `users.id`** — izmereno **21/21** razrešenih naloga po mejlu
//     (domen koristi 21 različit `auth.users` nalog; svi imaju parnjaka u 3.0).
//     Tih kolona ima **46** i sve su „ko je uradio" (`*_by`, `reported_by`,
//     `assigned_to`, `actor`, `technician_id`, `responsible_user_id`…). FK
//     ograničenja se prave u migraciji kao **SQL-only** (isti obrazac kao CHECK-ovi
//     i parcijalni indeksi): 46 Prisma relacija tražilo bi 46 povratnih polja na
//     `User`, a modul ih NIKAD ne džoinuje — imena autora se rešavaju batch-om.
//     ON DELETE semantika je prepisana sa žive sy15 (SET NULL / RESTRICT / CASCADE),
//     ne izmišljena.
//  3. **23 PG enum tipa -> String + CHECK** (BACKEND_RULES §2.2), isti skup
//     vrednosti, `VarChar(20)` (najduža vrednost je `motor_transmisija` = 17).
//  4. Unutrašnji FK-ovi domena (37) OSTAJU prave Prisma relacije — njih modul
//     stvarno prati (nalog -> sredstvo, incident -> nalog, dokument -> vozač…).
//  5. RLS politike se NE prenose (**102 politike na 34 tabele**) — 3.0 koristi
//     guardove i query-scoping (ODLUKE.md). Zato `OdrzavanjeAuthzService`
//     MORA da postoji: u sy15 je row-scope sprovodio RLS pa ga kod namerno nije
//     duplirao; bez prepisa bi prava TIHO nestala.
//  6. Trigeri se dele: **mehanika se prenosi** (`touch_updated_at` na 18 tabela,
//     dodela `wo_number`), **logika se prepisuje u NestJS** (auto-kreiranje naloga
//     iz incidenta, audit tragovi, enqueue obaveštenja, guardovi tipa sredstva).
//     Spisak izostavljenih je u zaglavlju migracije.
//  7. Fajlovi OSTAJU u sy15 storage-u (`maint-machine-files`, 59 objekata / 469 MB).
//     Prenose se samo putanje; URL-ovi ka sy15 gateway-u ostaju važeći.
//
// ŠAVOVI KA DRUGIM DOMENIMA (nema ih po FK grafu, ali POSTOJE po view/triger
// grafu — v. runbook §4; ovo je glavna korekcija polazne pretpostavke):
//   a) `v_rev_machines` je `SELECT … FROM maint_machines` — Reversi (korak 3)
//      čitaju mašine odavde;
//   b) triger `maint_machines_sync_to_loc` PIŠE u `loc_locations` (Lokacije, korak 3);
//   c) `ai_chat_prijavi_kvar` INSERT-uje u `maint_incidents` — AI-chat piše u
//      ovaj domen iz drugog modula.

/// CMMS sredstvo (mašina/vozilo/IT/objekat). Was: sy15 `public.maint_assets`.
/// assetType: machine | vehicle | it | facility
/// status: running | degraded | down | maintenance
model MaintAsset {
  assetId           String    @id(map: "pk_maint_assets") @default(uuid(4)) @map("asset_id") @db.Uuid
  assetCode         String    @map("asset_code")
  assetType         String    @map("asset_type") @db.VarChar(20)
  name              String    @map("name")
  status            String    @default("running") @map("status") @db.VarChar(20)
  locationId        String?   @map("location_id") @db.Uuid
  /// U sy15 `auth.users.id` (uuid); prevedeno na `users.id` (odluka 2).
  responsibleUserId Int?      @map("responsible_user_id")
  manufacturer      String?   @map("manufacturer")
  model             String?   @map("model")
  serialNumber      String?   @map("serial_number")
  dateOfPurchase    DateTime? @map("date_of_purchase") @db.Date
  warrantyUntil     DateTime? @map("warranty_until") @db.Date
  supplier          String?   @map("supplier")
  /// Token QR nalepnice sredstva — jedinstven, prenosi se DOSLOVNO (odštampane
  /// nalepnice moraju da nastave da rade posle preklopa).
  qrToken           String    @default(uuid(4)) @map("qr_token")
  active            Boolean   @default(true) @map("active")
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy         Int?      @map("updated_by")
  notes             String?   @map("notes")
  archiveReason     String?   @map("archive_reason")
  archivedBy        Int?      @map("archived_by")

  location            MaintLocation?            @relation(fields: [locationId], references: [locationId], onDelete: SetNull, onUpdate: NoAction, map: "fk_maint_assets_location")
  machine             MaintMachine?
  vehicleDetails      MaintVehicleDetails?
  itDetails           MaintItAssetDetails?
  facilityDetails     MaintFacilityDetails?
  workOrders          MaintWorkOrder[]
  incidents           MaintIncident[]
  documents           MaintDocument[]
  tasks               MaintTask[]
  tires               MaintVehicleTire[]
  bookings            MaintVehicleBooking[]
  partVehicles        MaintPartVehicle[]
  servicePlans        MaintAssetServicePlan[]
  vehicleServicePlans MaintVehicleServicePlan[]

  // SQL-only: uq lower(asset_code), uq qr_token, parcijalni idx po tipu, CHECK-ovi.
  @@map("maint_assets")
}

