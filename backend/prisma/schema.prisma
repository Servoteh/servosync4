/// Was: PSF_AnalitickaKonta_T  — AUTORITATIVAN registar saldakonto konta (review VISOK).
/// Rešava BigBit ograničenje "jedan kontrolni konto": lista, sa stranom i kontrolnim kontom.
/// SVE faze čitaju OVAJ registar (posting F2, saldakonti F4, PS prenos FN), ne hardkod klase.
/// Nesa potvrđuje spisak pod-konta pre Faze 2.
model SaldakontoAccount {
  account         String   @id(map: "pk_saldakonto_accounts") @map("account") @db.VarChar(10) // FK Account.code
  side            String   @map("side") @db.VarChar(10) /// receivable | payable — STRANA SALDA (ne vrsta partnera!)
  /// customer | supplier — VRSTA PARTNERA na kontu; NULL = nepoznato.
  /// Uveden migracijom 20260726100000 jer `side` sam ne razlikuje kupca od dobavljača:
  /// primljeni avansi (4300/4302) su payable ali su KUPČEVI, dati avansi (1520/1521/1530)
  /// su receivable ali su DOBAVLJAČEVI. Po ovoj koloni biraju priprema plaćanja
  /// (samo 'supplier'), kreditni limit i kamata (samo 'customer') i aging bez konta.
  partnerScope    String?  @map("partner_scope") @db.VarChar(10)
  controlAccount  String   @map("control_account") @db.VarChar(10) // sintetički kontrolni (2040->204, 4351->435)
  tracksOpenItems Boolean  @default(true) @map("tracks_open_items") // OTST
  holdsDinBalance Boolean  @default(true) @map("holds_din_balance") // DinSaldo
  holdsFxBalance  Boolean  @default(false) @map("holds_fx_balance") // DevSaldo (izvozne/devizne 2050/4360)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// OZNAKA POREKLA (noćni .mdb uvoz) — vidi Account.importedDropId.
  importedDropId Int? @map("imported_drop_id")

  accountRef   Account    @relation(fields: [account], references: [code], onDelete: Cascade, map: "fk_saldakonto_account")
  importedDrop BbMdbDrop? @relation(fields: [importedDropId], references: [id], onDelete: Restrict, map: "fk_saldakonto_imported_drop")

  @@index([controlAccount], map: "idx_saldakonto_control")
  @@index([importedDropId], map: "idx_saldakonto_imported_drop")
  @@map("saldakonto_accounts")
}

