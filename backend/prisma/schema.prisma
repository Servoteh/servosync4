  identMark         String                @map("ident_mark") @db.VarChar(50)
  pieceCount        Int                   @map("piece_count")
  signature         String?               @map("signature") @db.VarChar(50)
  workerSymbol      Boolean?              @default(false) @map("worker_symbol")
  processSymbol     Boolean?              @default(false) @map("process_symbol")
  operationSymbol   Boolean?              @default(false) @map("operation_symbol")
  finishedAt        DateTime?             @map("finished_at") @db.Timestamp(6)
  isProcessFinished Boolean?              @default(false) @map("is_process_finished")
  note              String?               @map("note")
  workOrderId       Int                   @default(0) @map("work_order_id")
  qualityTypeId     Int                   @default(0) @map("quality_type_id")
  reworkOperationId Int?                  @default(0) @map("rework_operation_id")
  worker            Worker                @relation(fields: [workerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tech_processes_worker")
  documents         TechProcessDocument[]
  workTimeEntries   WorkTimeEntry[]

  // PERF (Faza 6 analize): sve vruće kiosk putanje filtriraju po trojci+operaciji
  // (scan/control/kumulativ/markComplete), lista po entered_at desc, veze po
  // work_order_id. Kreirani CONCURRENTLY na prod-u 2026-07-16 (migracija
  // 20260716120000). 98k redova, ranije SAMO PK → seq scan na svakom skenu.
  @@index([projectId, identNumber, variant, operationNumber, workCenterCode], map: "idx_tp_trojka_op")
  @@index([workOrderId], map: "idx_tp_work_order")
  @@index([enteredAt], map: "idx_tp_entered_at")
  @@index([workerId], map: "idx_tp_worker")
  // AI-5 (review [10]): procena vremena po radnom mestu (estimateByWorkCenter,
  // 2× po pozivu) filtrira po work_center_code — bez indeksa Seq Scan 99k (~114ms).
  // Vodeći stolbac idx_tp_trojka_op je project_id, pa NE služi ovaj predikat.
  @@index([workCenterCode], map: "idx_tech_processes_work_center_code")
  @@map("tech_processes")
}

/// New in 2.0 — per-execution work-time ledger ("dva skena": START + STOP).
/// Decomposes legacy tTehPostupak.DatumIVremeUnosa/DatumIVremeZavrsetka into an
/// append-only session ledger. tech_processes keeps the accumulated pieceCount;
/// a session's piece_count is that stop-scan's contribution (reconciled by construction).
model WorkTimeEntry {
  id              Int         @id(map: "pk_work_time_entries") @default(autoincrement()) @map("id")
  techProcessId   Int         @map("tech_process_id")
  workOrderId     Int?        @map("work_order_id")
  projectId       Int         @default(0) @map("project_id")
  identNumber     String      @map("ident_number") @db.VarChar(50)
  variant         Int         @default(0) @map("variant")
  operationNumber Int         @map("operation_number")
  workCenterCode  String      @map("work_center_code") @db.VarChar(5)
  workerId        Int         @map("worker_id")
  startedAt       DateTime    @map("started_at") @db.Timestamptz(6)
  stoppedAt       DateTime?   @map("stopped_at") @db.Timestamptz(6)
  pieceCount      Int         @default(0) @map("piece_count")
  qualityTypeId   Int         @default(0) @map("quality_type_id")
  autoClosed      Boolean     @default(false) @map("auto_closed")
  note            String?     @map("note")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  techProcess     TechProcess @relation(fields: [techProcessId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_work_time_entries_tech_process")
  worker          Worker      @relation(fields: [workerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_work_time_entries_worker")

  @@index([techProcessId], map: "idx_work_time_entries_tech_process")
  @@index([startedAt], map: "idx_work_time_entries_started_at")
  // + SQL-only parcijalni indeks idx_work_time_entries_open (worker_id WHERE
  // stopped_at IS NULL) za kiosk „moje otvorene sesije" i auto-close — Prisma ne
  // ume partial, živi samo u migraciji 20260725160000 (kao uq_stock_documents_po).
  @@index([workerId], map: "idx_work_time_entries_worker")
  // AI-1 (20260726160000): sve dosadašnje putanje idu preko tech_process_id, pa
  // je „stvarno vreme po operaciji naloga" radilo Seq Scan preko 99k redova PO
  // OPERACIJI. Alati istorija_crteza / tehnoloski_postupak_naloga filtriraju baš
  // po ovoj dvojci.
  @@index([workOrderId, operationNumber], map: "idx_work_time_entries_work_order")
  @@map("work_time_entries")
}

