  workDate   DateTime @map("work_date") @db.Date
  lockedBy   String   @map("locked_by") @db.VarChar(160)
  lockedAt   DateTime @default(now()) @map("locked_at") @db.Timestamptz(6)
  note       String?  @map("note")

  @@unique([employeeId, workDate], map: "uq_kadr_grid_day_locks_emp_date")
  @@index([workDate], map: "idx_kadr_grid_day_locks_date")
  @@map("kadr_grid_day_locks")
}

// ============================================================================
// AI (Talas AI-0) — merenje i registar modela. Piše ih ISKLJUČIVO gateway
// (src/common/ai). Vidi docs/PLAN_AI_OS_2026-07.md §5 TALAS AI-0.
