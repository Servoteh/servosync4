model PbTaskFile {
  id               String    @id(map: "pk_pb_task_files") @default(uuid(4)) @map("id") @db.Uuid
  taskId           String    @map("task_id") @db.Uuid
  fileName         String    @map("file_name")
  storagePath      String    @unique(map: "uq_pb_task_files_storage_path") @map("storage_path")
