/// Zadatak projektnog biroa. Was: sy15 `pb_tasks`.
/// vrsta: Projektovanje 3D | Dokumentacija | Nabavka | Algoritam | Montaža (bio PG enum)
/// prioritet: Visok | Srednji | Nizak (bio PG enum)
/// status: Nije počelo | U toku | Pregled | Završeno | Blokirano (bio PG enum)
model PbTask {
  id                  String    @id(map: "pk_pb_tasks") @default(uuid(4)) @map("id") @db.Uuid
  naziv               String    @map("naziv")
  opis                String?   @map("opis")
  problem             String?   @map("problem")
  /// Predmet (3.0 `projects.id`) — v. prenosnu odluku 2.
  projectId           Int?      @map("project_id")
  /// MEKA veza -> sy15 `employees.id` (uuid). Kadrovska je korak 4 — odluka 5.
  employeeId          String?   @map("employee_id") @db.Uuid
  vrsta               String    @default("Projektovanje 3D") @map("vrsta") @db.VarChar(40)
  prioritet           String    @default("Srednji") @map("prioritet") @db.VarChar(20)
  status              String    @default("Nije počelo") @map("status") @db.VarChar(20)
  datumPocetkaPlan    DateTime? @map("datum_pocetka_plan") @db.Date
  datumZavrsetkaPlan  DateTime? @map("datum_zavrsetka_plan") @db.Date
  datumPocetkaReal    DateTime? @map("datum_pocetka_real") @db.Date
  datumZavrsetkaReal  DateTime? @map("datum_zavrsetka_real") @db.Date
  procenatZavrsenosti Int       @default(0) @map("procenat_zavrsenosti")
  /// Norma 1..7 sati dnevno — ulaz u `pb_get_load_stats`.
  normaSatiDan        Int       @default(4) @map("norma_sati_dan")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy           String?   @map("created_by") @db.VarChar(255)
  updatedBy           String?   @map("updated_by") @db.VarChar(255)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  project       Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_pb_tasks_project")
  comments      PbTaskComment[]
  files         PbTaskFile[]
  depsFrom      PbTaskDep[]         @relation("PbTaskDepTask")
  depsOn        PbTaskDep[]         @relation("PbTaskDepDependsOn")
  notifications PbNotificationLog[]

  @@index([employeeId], map: "idx_pb_tasks_employee")
  @@index([projectId], map: "idx_pb_tasks_project")
  @@index([status], map: "idx_pb_tasks_status")
  @@map("pb_tasks")
}

/// Komentar na zadatku. Was: sy15 `pb_task_comments`.
model PbTaskComment {
  id              String    @id(map: "pk_pb_task_comments") @default(uuid(4)) @map("id") @db.Uuid
  taskId          String    @map("task_id") @db.Uuid
  body            String    @map("body")
  /// Pomenuti mejlovi (@mention) — čist tekst, ne FK.
  mentions        String[]  @default([]) @map("mentions")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by") @db.VarChar(255)
  /// U sy15 je bio `auth.users.id` (uuid); prevedeno na `users.id` (odluka 4).
  createdByUserId Int?      @map("created_by_user_id")
  editedAt        DateTime? @map("edited_at") @db.Timestamptz(6)

  task        PbTask @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pb_task_comments_task")
  createdUser User?  @relation(fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_pb_task_comments_user")

  @@index([taskId, createdAt(sort: Desc)], map: "idx_ptc_task_created")
  @@map("pb_task_comments")
}

/// Zavisnost između zadataka (`task` čeka `dependsOn`). Ciklus brani servis
/// (u sy15 je to radio trigger `pb_task_deps_check_cycle_trg`). Was: sy15 `pb_task_deps`.
model PbTaskDep {
  id              String   @id(map: "pk_pb_task_deps") @default(uuid(4)) @map("id") @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  dependsOnTaskId String   @map("depends_on_task_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?  @map("created_by") @db.VarChar(255)

  task      PbTask @relation("PbTaskDepTask", fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pb_task_deps_task")
  dependsOn PbTask @relation("PbTaskDepDependsOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pb_task_deps_depends_on")

  @@unique([taskId, dependsOnTaskId], map: "uq_pb_task_deps_task_depends")
  @@index([dependsOnTaskId], map: "idx_ptd_depends_on")
  @@index([taskId], map: "idx_ptd_task")
  @@map("pb_task_deps")
}

/// Prilog na zadatku. `storagePath` pokazuje na sy15 bucket `pb-task-files`.
