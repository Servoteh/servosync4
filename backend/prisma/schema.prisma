  poreklo       String? @map("poreklo") // Poreklo
  opis          String? @map("opis") // Opis
  podgrupaVeza  String? @map("podgrupa_veza") // PodgrupaVeza -> R_Podgrupa.Podgrupa
  popustProc    String? @map("popust_proc") // PopustProc

  drop BbMdbDrop @relation(fields: [dropId], references: [id], onDelete: Cascade, map: "fk_bb_mdb_stage_poreklo_drop")

  @@index([dropId], map: "idx_bb_mdb_stage_poreklo_drop")
  @@map("bb_mdb_stage_poreklo")
}

model BbMdbStageMagacin {
  id               Int     @id(map: "pk_bb_mdb_stage_magacini") @default(autoincrement()) @map("id")
  dropId           Int     @map("drop_id")
