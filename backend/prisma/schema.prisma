/// pa je `qualityTypeId` visio u prazno (`ITEM_FIELDS_REQUIRING_MIGRATION`).
/// `id` je BigBit `IDKvalitetArtikla` i prenosi se doslovno (0 je važeća
/// vrednost, ne „prazno") — zato bez `autoincrement()`.
model ItemQualityType {
  id          Int    @id(map: "pk_item_quality_types") @map("id")
  code        String @map("code") @db.VarChar(20)
  /// Doslovna BigBit vrednost — red `id = 0` u izvoru glasi „NE TREBA KVAKITET"
  /// (tipfeler je u BigBitu, ne kod nas; prenosi se verno radi pariteta prikaza).
  description String @map("description") @db.VarChar(50)

  @@map("item_quality_types")
}

/// Was: RasterDefZag
/// Kod Servoteha raster NIJE maloprodajni koncept (veličine/boje) nego nosilac
/// DIMENZIJA table/lima (BIGBIT_ARTIKLI.md §4.10). BigBit forma ga nudi kao
/// padajući spisak „Dimenzija (mm)".
model ItemRaster {
  id          Int     @id(map: "pk_item_rasters") @map("id")
  name        String  @map("name") @db.VarChar(50)
  description String? @map("description") @db.VarChar(50)
  /// `VrstaRastera` / `KolonaRastera` u mm — ulaz za obračun kilograma po komadu
  /// lima: `Kutija = Debljina * VrstaRastera * KolonaRastera * 7850 / 1e9`
  /// (7850 = gustina čelika kg/m³). Dimenzija, ne novac → `Float`, kao i
  /// `Item.thickness` / `Item.weightKg`.
  widthMm     Float?  @map("width_mm")
  lengthMm    Float?  @map("length_mm")

  @@map("item_rasters")
}

/// Was: R_Vrste_dokumenata
model DocumentType {
  id                   Int      @id(map: "pk_document_types") @default(autoincrement()) @map("id")
  code                 String   @map("code") @db.VarChar(5)
  description          String   @map("description") @db.VarChar(50)
  isInbound            Boolean  @default(false) @map("is_inbound")
