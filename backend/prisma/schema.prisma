  // NOVAC = Decimal(19,4), nikad Float (BACKEND_RULES). Konvertovano migracijom
  // 20260728170000; izmereno na svih 92.511 produkcionih redova: 0 vrednosti
  // promenjeno, 0 overflow, 0 NaN — konverzija je bila tačna.
  wholesalePrice        Decimal?  @default(0) @map("wholesale_price") @db.Decimal(19, 4)
