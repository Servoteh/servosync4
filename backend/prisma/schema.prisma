  customsTariff         String?   @map("customs_tariff") @db.VarChar(20)
  originCountry         String?   @map("origin_country") @db.VarChar(20)
  /// BigBit `Polica` je Text(20); QBigTehn kopija ju je suzila na 10 i mi smo to
  /// nasledili. Prošireno na 20 (20260728170000) — 82 artikla na produkciji imaju
  /// tačno 10 znakova, tj. već odsečenu vrednost (dopunjuje ih sledeći pun uvoz).
  shelf                 String?   @map("shelf") @db.VarChar(20)
  foreignName           String?   @map("foreign_name") @db.VarChar(50)
  supplierId            Int?      @default(1) @map("supplier_id")
  webDescription        String?   @map("web_description") @db.VarChar(255)
  itemDescription       String?   @map("item_description") @db.VarChar(50)
