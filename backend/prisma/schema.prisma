  maxDiscountPercent    Float?    @default(100) @map("max_discount_percent")
  memo                  String?   @map("memo")
  accountingCode        String?   @default("0") @map("accounting_code") @db.VarChar(10)
  itemExcise            Decimal?  @default(0) @map("item_excise") @db.Decimal(19, 4)
  accountingCode2       String?   @default("0") @map("accounting_code_2") @db.VarChar(10)
