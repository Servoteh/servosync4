  template SastanciTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sastanci_template_ucesnici_template")

  @@id([templateId, email], map: "pk_sastanci_template_ucesnici")
  @@map("sastanci_template_ucesnici")
}

/// Red čekanja + trag poslatih obaveštenja sastanaka (mejl kanal).
/// Ovo je RED ČEKANJA, ne samo log: `status='queued'` čeka dispatch
/// (`SastanciDispatchService`, job `sastanci-notify-dispatch`).
/// Was: sy15 `sastanci_notification_log`.
/// kind: akcija_new | akcija_changed | meeting_invite | meeting_locked |
///       action_reminder | meeting_reminder | meeting_prep_reminder | meeting_cancel
/// channel: email | whatsapp ; status: queued | sent | failed | skipped
model SastanciNotificationLog {
  id                String    @id(map: "pk_sastanci_notification_log") @default(uuid(4)) @map("id") @db.Uuid
  kind              String    @map("kind") @db.VarChar(40)
  channel           String    @default("email") @map("channel") @db.VarChar(20)
  recipientEmail    String    @map("recipient_email") @db.VarChar(255)
  recipientLabel    String?   @map("recipient_label")
  subject           String    @map("subject")
  bodyHtml          String?   @map("body_html")
  bodyText          String?   @map("body_text")
  relatedSastanakId String?   @map("related_sastanak_id") @db.Uuid
  relatedAkcijaId   String?   @map("related_akcija_id") @db.Uuid
  status            String    @default("queued") @map("status") @db.VarChar(20)
  scheduledAt       DateTime  @default(now()) @map("scheduled_at") @db.Timestamptz(6)
  nextAttemptAt     DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastAttemptAt     DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  attempts          Int       @default(0) @map("attempts")
  maxAttempts       Int       @default(5) @map("max_attempts")
  error             String?   @map("error")
  payload           Json?     @map("payload")
  createdByEmail    String?   @map("created_by_email") @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(6)

  sastanak Sastanak?     @relation(fields: [relatedSastanakId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_sastanci_notification_log_sastanak")
  akcija   AkcionaTacka? @relation(fields: [relatedAkcijaId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_sastanci_notification_log_akcija")

  @@index([recipientEmail, kind, createdAt(sort: Desc)], map: "idx_sast_notif_recipient")
  // SQL-only: parcijalni indeks reda čekanja + DVA parcijalna unique-a koji
  // sprečavaju dupli podsetnik po događaju/akciji (WHERE status IN ('queued','sent')).
  @@map("sastanci_notification_log")
}

