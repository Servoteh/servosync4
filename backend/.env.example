# Kopiraj u .env: cp .env.example .env
# Postgres iz docker-compose.yml mora da radi: docker compose up -d db

DATABASE_URL="postgresql://servosync:servosync_dev@localhost:5435/servosync?schema=public"
PORT=3000

# Optional: serve the built frontend (Next static export `out/`) from THIS API on the
# same origin — LAN/offline access without Cloudflare or CORS (front na http://<host>:3000,
# API na .../api). Point at the dir that holds index.html/login.html. Prazno = samo API
# (dev/default). Na serveru je to montirani volume, npr. /app/frontend-static
# (v. docs/infra/INFRASTRUKTURA.md → „Front na :3000").
FRONTEND_STATIC_DIR=

# --- BigBit / QBigTehn (MSSQL) source for on-demand sync ---
# Read-only login (bridge_reader already exists in QBigTehn). Reachable over the
# company WireGuard VPN. Use the FQDN (or IP 192.168.64.25) — the bare NetBIOS
# name "Vasa-SQL" does not resolve on macOS.
BIGBIT_DB_HOST=Vasa-SQL.servoteh.local
BIGBIT_DB_PORT=5765
BIGBIT_DB_NAME=QBigTehn
BIGBIT_DB_USER=bridge_reader
BIGBIT_DB_PASSWORD=
BIGBIT_DB_ENCRYPT=false
BIGBIT_DB_TRUST_SERVER_CERT=true
BIGBIT_DB_REQUEST_TIMEOUT_MS=30000
BIGBIT_DB_POOL_MAX=5

# --- Auth (JWT) ---
JWT_SECRET=change_me_in_production
# Access token TTL. Kratko (24h) jer refresh token tiho obnavlja sesiju (§7).
JWT_EXPIRES_IN=24h
# Refresh token životni vek u danima (KLIZNO: svaka rotacija = novih N dana).
# POST /api/auth/refresh rotira par; reuse opozvanog tokena opoziva sve tokene korisnika.
# Default 30. Prod: 30.
REFRESH_TOKEN_TTL_DAYS=30
# SSO sa ServoSync 1.0/1.5 shell-a (iframe modul „Tehnologija"): JWT_SECRET
# sy15 GoTrue stacka (na serveru: ~/servosync15/.env). POST /api/auth/sso
# verifikuje 1.0 access token ovim secretom i po email-u (users.email) izda
# naš token. Prazno = SSO isključen (endpoint vraća 401).
SY15_JWT_SECRET=
# sy15 (1.0) PostgreSQL baza — drugi datasource za 3.0 pilot module (Reversi;
# MODULE_SPEC_reversi.md §0). Na serveru: sy15-db kontejner (ista mašina).
# Prazno = pilot moduli vraćaju 503, ostatak aplikacije radi normalno.
SY15_DATABASE_URL=
# sy15 PostgREST baza URL za SSO JIT provisioning (čitanje 1.0 role RPC-om
# get_my_user_roles sa korisnikovim tokenom). Prazno = javni
# https://api.servosync.servoteh.com/rest/v1; na serveru bolje LAN vhost
# http://192.168.64.28:8090/rest/v1 (radi i bez interneta/CF).
SY15_REST_URL=

# --- Authz (RBAC guard rollout, AUTHZ_UNIFIED.md §6.1/§8) ---
# true = enforce (403 on missing permission); false = SHADOW MODE (evaluates + logs
# would-be 403s, allows). FAIL-CLOSED (review Opus 5): u NODE_ENV=production enforce je
# PODRAZUMEVAN — shadow se mora tražiti eksplicitno sa AUTHZ_ENFORCE=false. Van produkcije
# default ostaje shadow (dev/e2e ne traže env). Rollback = postavi false + restart.
AUTHZ_ENFORCE=false

# --- CORS (review Opus 5) ---
# Zarezom razdvojena lista dozvoljenih Origin-a za API (npr.
# https://servosync.servoteh.com,https://servosync2.servoteh.com).
# Prazno: u produkciji se dozvoljavaju samo *.servoteh.com domeni; van produkcije sve
# (lokalni dev). Ranije je bilo `origin: true` — svaki sajt je mogao slati autentikovane
# zahteve, pa je ovo sužavanje bezbednosna ispravka.
CORS_ORIGINS=

# Tvrda brava na vidljivost/izmenu zarada (kadrovska.salary) — zarezom razdvojeni
# mejlovi koji JEDINI smeju plate, NEZAVISNO od role/override (odluka vlasnika 21.07).
# Prazno/nepostavljeno = default (Nenad + Nevena). Podesivo bez deploya (restart).
KADROVSKA_SALARY_ALLOWLIST=nenad.jarakovic@servoteh.com,nevena.knezevic@servoteh.com

# --- Legacy primopredaje guard (tranziciona politika do cutover-a) ---
# Derivacioni sync izvodi drawing_handovers redove iz tRN atributa (legacy_rn_id !=
# NULL) i pri svakom prolazu ih PREGAZI iz QBigTehn-a (legacy = izvor istine do
# cutover-a). true (default) = approve/reject/launch/prepare/return nad deriviranim
# redovima vraća 409 — odobravanje se radi u QBigTehn-u (Miljan). Nativni redovi
# (legacy_rn_id = NULL) nisu blokirani. UKIDANJE NA CUTOVER: false + compose up
# (isti rollback obrazac kao AUTHZ_ENFORCE); kolona legacy_rn_id ostaje kao provenance.
HANDOVER_LEGACY_GUARD=true

# --- Transakcioni mejl (Resend; src/common/mail/mail.service.ts) ---
# API ključ Resend naloga (isti servis i verifikovan domen kao ServoSync 1.0).
# Prazno = DRY-RUN: mejl se loguje ali se NE šalje — aplikacija radi normalno.
RESEND_API_KEY=
# „From" adresa (verifikovan domen). Prazno = "Servoteh <obavestenja@servoteh.com>".
RESEND_FROM=

# --- Štampa nalepnica (RAW TSPL2 → TCP; POST /tech-processes/labels/print) ---
# Mrežni termalni štampač (TSC ML340P). Server šalje direktno na TCP 9100.
LABEL_PRINTER_HOST=192.168.70.20
LABEL_PRINTER_PORT=9100

# --- PRIVREMENO: test radnici (ODLUKE #32) ---
# CSV worker id-jeva koji preskaču SERVISNE kiosk provere (machine-access, kontrolor-auth,
# razdvajanje dužnosti) — za testiranje tokova. UKINUTI brisanjem reda + compose up -d.
AUTHZ_TEST_WORKER_IDS=

# --- Read-only (test) nalozi ---
# CSV user id-jeva (users.id) kojima je SVAKA mutacija (POST/PUT/PATCH/DELETE) blokirana
# sa 403 + porukom "test nalog"; GET radi normalno, /auth/login i /auth/sso nisu pogođeni.
# Front dobija readOnly=true u login/sso/me odgovoru i prikazuje trajni baner.
# Prod: 49 = test@servoteh.com. Rollback = obriši red + compose up -d.
AUTHZ_READONLY_USER_IDS=

# sy15 storage-api (bucket reversal-pdf, sastanci-arhiva, sastanak-slike… — 8 modula).
# ⚠️ MORA biti JAVNI gateway URL sa /storage/v1 prefiksom, npr.
#   SY15_STORAGE_URL=https://api.servosync.servoteh.com/storage/v1
# NE interni docker host (sy15-storage:5000): (a) `/storage/v1` prefiks skida Caddy
# gateway — storage-api (Fastify) ga ne poznaje pa direktan pogodak vraća 404; (b)
# signUrl() vraća `${base}${signedURL}` koji otvara BROWSER, pa base mora biti javno
# dostupan. Interni host je 20.07.2026 oborio SVE BE storage tokove (upload+sign) —
# vidi docs/PLAN_SASTANCI_PRIMEDBE_2026-07-20.md §S0. + service key sy15 stacka
# (~/servosync15/.env SERVICE_ROLE). Prazno = PDF/storage rute vraćaju 503.
SY15_STORAGE_URL=
SY15_SERVICE_KEY=
# --- Talas D / D1: dvostrano upravljanje nalozima (Podešavanja WRITE) ---
# GoTrue admin baza sy15 stacka (create/reset). Prazno = izvedeno iz SY15_REST_URL
# (`/rest/v1`→`/auth/v1`). SY15_SERVICE_KEY (gore) je apikey/Bearer. Prazno oboje = 503.
SY15_AUTH_URL=
# Link u welcome/reset mejlu (kadr_notification_log outbox); default servosync.servoteh.com.
# ⚠️ Zahtevi mejlovi (link ka /zahtevi/detalj) koriste ISTU promenljivu, ali im je fallback
# servosync2.servoteh.com — to je stvarni produkcioni front (docs/infra/INFRASTRUKTURA.md).
# Postavi je eksplicitno da svi mejlovi vode na isto mesto.
SY15_APP_URL=

# --- Zahtevi (AI PM modul) — AI cevovod (MODULE_SPEC_zahtevi §4/§13.3) ---
# Modeli za AI trijažu/analizu idu kroz AiProviderService (ANTHROPIC_API_KEY / OPENAI_API_KEY).
# Bez ključa: analiza pada u FAILED not_configured, ali modul radi normalno (doktrina §10.4).
# Promena modela = samo restart (bez deploya). Presuda §13.3: Haiku trijaža / Sonnet analiza.
# Trijaža — jeftin/brz model (auto na svaki submit): ocena 0–5 + klasifikacija + duplikati.
ZAHTEVI_TRIAGE_MODEL=claude-haiku-4-5-20251001
# Detaljna analiza — jak model (SAMO na admin klik „Odobri AI analizu"): AC/rizici/Claude paket.
ZAHTEVI_ANALYSIS_MODEL=claude-sonnet-5
# Obaveštenja podnosiocu mejlom (MODULE_SPEC §9, presuda §13.4): default TRUE (uključeno odmah).
# Šalje se na odluku (approve/reject/needs-info) i na završetak (DONE). Ide kroz MailService
# (Resend); bez RESEND_API_KEY je DRY-RUN (loguje, ne šalje). Slanje NIKAD ne obara radnju.
# Isključi samo eksplicitno: ZAHTEVI_MAIL_NOTIFY=false.
ZAHTEVI_MAIL_NOTIFY=true
# Na svaki submit ide i mejl administratorima o novoj ideji / dopunjenom zahtevu.
# PRESUDA 24.07: ako je ZAHTEVI_ADMIN_MAILS postavljen (CSV), to je AUTORITATIVNA "to" lista
# (override, NE fallback) — bira ko prima ove mejlove (neki admini, npr. Luka/Nevena, ne žele).
# ZAHTEVI_ADMIN_CC (CSV, opciono) ide kao CC. Ako je ZAHTEVI_ADMIN_MAILS prazan → svi aktivni
# admini iz baze (users.role='admin').
ZAHTEVI_ADMIN_MAILS=
ZAHTEVI_ADMIN_CC=
# 03.08.2026 — mejl na SVAKI korisnički komentar (POST :id/comments od ne-admina) i na
# prijavu „ne radi" (POST :id/reopen). Nalaz vlasnika: „ako neko tu pošalje dodatna pitanja
# nakon našeg mejla, to uopšte nismo ni registrovali!" — komentar je do sada bio samo red
# u bazi. Naslov razlikuje slučajeve: „💬 komentar od X" vs „⚠ Ne radi (vraćeno u rad), X".
# CSV; PRAZNO → nenad.jarakovic@servoteh.com. Namerno UŽE od ZAHTEVI_ADMIN_MAILS: ovo je
# operativni signal „neko čeka odgovor", ne obaveštenje celoj administraciji.
# Poštuje ZAHTEVI_MAIL_NOTIFY; slanje NIKAD ne obara upis komentara.
ZAHTEVI_COMMENT_MAILS=

# Neusaglašenosti na montaži (zahtev 004/26, MODULE_SPEC_montaza_neusaglasenosti §2):
# na svaku novu prijavu ide mejl rolи `menadzment` (aktivni korisnici sa email-om), a na
# ZAVRSENO mejl podnosiocu. Ide kroz MailService (Resend); bez RESEND_API_KEY je DRY-RUN.
# Slanje NIKAD ne obara prijavu. Isključi samo eksplicitno: MONTAZA_NM_MAIL_NOTIFY=false.
MONTAZA_NM_MAIL_NOTIFY=true

# Škart i dorada (MODULE_SPEC_kvalitet_skart_dorada §4): kada POTVRDJEN događaj pređe prag,
# ide zvonce menadžmentu (in-app + mail rolи `menadzment`). Prag: pojedinačna qty >= _ALERT_QTY
# ILI >= _ALERT_COUNT potvrđenih događaja istog razloga u poslednjih 7 dana. Mejl ide kroz
# MailService (Resend); bez RESEND_API_KEY je DRY-RUN. Slanje NIKAD ne obara unos.
# Isključi mejl eksplicitno: KVALITET_EVENT_MAIL_NOTIFY=false (in-app zvonce ostaje).
KVALITET_EVENT_MAIL_NOTIFY=true
KVALITET_EVENT_ALERT_QTY=5
KVALITET_EVENT_ALERT_COUNT=3

# Auto-predlog mesečnog grida iz kapije (zahtev 012/26, presuda Nenad 24.07): sistem
# svakodnevno upiše PREDLOG sati iz STVARNOG prisustva (kucanje → v_attendance_vs_grid)
# za prazne grid-dane SVIH odeljenja; INSERT ... ON CONFLICT DO NOTHING (nikad ne gazi
# ručni unos), marker work_hours.last_edited_by='auto:kapija'. Okidač = INTERNI tik
# (setInterval ~30min; obrada „juče" posle 05:00 Europe/Belgrade; SAMO kad je
# NODE_ENV=production — dev/CI ne piše u živu bazu). Ručni backfill/dry-run =
# POST /kadrovska/grid/autofill-run (gornja granica se klampuje na juče). Kill-switch:
# postavi na false da se i tik i svaki upis (dnevni I backfill) pretvore u no-op.
# Default UKLJUČENO.
KADROVSKA_GRID_AUTOFILL=true

# --- Scheduler (Talas A — src/modules/scheduler) ---
# 'true' = pogon zakazanih poslova radi (paritet 1.0 automatika: HR podsetnici,
# sastanci, CMMS rokovi... — poslovi zovu postojeće sy15 SECURITY DEFINER fn preko
# SY15_DATABASE_URL). Prazno/izostavljeno = pogon UGAŠEN (deploy koda je bezbedan);
# poslovi se i tada mogu okinuti ručno (POST /api/v1/scheduler/jobs/:key/run-now,
# admin). CUTOVER: uključi ovde → uporedi sa sy15 pg_cron dan-dva → ugasi sy15
# cron poslove (cron.unschedule). Dnevnik: tabela scheduled_job_runs (glavna baza).
# Preporuka za prod: u SY15_DATABASE_URL dodati `?options=-c%20statement_timeout%3D120000`
# (tvrdi server-side prekid visećeg poziva; klijentski Promise.race 120s postoji u kodu).
SCHEDULER_ENABLED=

# --- BigBit noćni sync (Pruga P — scheduler/bigbit-sync-jobs.service.ts) ---
# 'true' = posao `bigbit-nightly-sync` se REGISTRUJE i svake noći u 03:30 (posle
# backupa u 02:30) povlači BigBit master podatke — isti `SyncService.run()` koji
# stoji iza ručnog dugmeta POST /api/v1/sync/run, samo `trigger:"cron"`, bez
# `force` i bez nametnute strategije. Traži i SCHEDULER_ENABLED=true (pogon) i
# podešene BIGBIT_DB_* (izvor).
# ODVOJEN prekidač namerno: automatsko prepisivanje šifarnika mora da bude svesna
# odluka. Prazno/'false' = posao se NE registruje (ne vidi se u /scheduler/jobs,
# nema ni run-now) → deploy koda je bezbedan; povlačenje ostaje ručno.
# ⚠️ ISKLJUČENO IZ PROLAZA JE 9 TOKOVA, NE JEDAN (reopen 061/26, 04.08.2026):
#   items, customers, projects, access_rights, goods_documents_mirror, journal,
#   notifications, price_list_entries, warehouses
# Razlog nije više „čekamo čišćenje duplikata katbroja" nego MRTAV IZVOR: BigBit→
# QBigTehn prenos je ugašen 22.07.2026, pa MSSQL kopija stoji na tom datumu —
# šest tabela je prazno (svaki prolaz = greška), a artikle/predmete/komitente od
# 30.07. vozi noćni .mdb uvoz (03:45), koji bi ovaj posao (03:30) svako jutro
# pregazio starim podacima. Isti skup podrazumevano preskače i ručni
# POST /sync/run; eksplicitno pokretanje sme samo admin (uz upozorenje u logu).
# Merodavan spisak i uslov za povratak (OŽIVLJEN izvor, ne čist katalog):
# `DEFAULT_SYNC_EXCLUDED` u sync/table-ownership.ts.
# `tax_rates` NIJE isključenje nego je izbačen iz sync mape (4.0-owned od 26.07).
# Dnevnik: `scheduled_job_runs` (job_key='bigbit-nightly-sync', summary sa
# brojevima po toku) + `bb_sync_log` (trigger='cron').
#
# AKTIVACIJA (redosled koraka — review 26.07 [15]):
#  1. `SCHEDULER_ENABLED=true` mora već biti aktivan (pogon), a BIGBIT_DB_* podešeni.
#  2. Dodaj `BIGBIT_NIGHTLY_SYNC=true` u backend.env na serveru + restart kontejnera.
#     Provera: GET /api/v1/scheduler/jobs — posao `bigbit-nightly-sync` mora biti
#     na spisku (19. posao) sa rasporedom 03:30.
#  3. Prekopiraj monitor skriptu na server (repo je referenca, server izvršilac):
#     `scp backend/scripts/monitor-sy15.sh ubuntusrv:/home/admnenad/ops/` — bez toga
#     nema alarma za padove sync-a (sekcija 9) ni podignutog outbox praga (sekcija 2).
#  4. Prva noć: ujutru pogledaj `scheduled_job_runs` (summary sa brojevima po toku)
#     i `bb_sync_log` (trigger='cron'); `partial` zbog preskočenih redova je NORMALNO.
#  5. `items` NE ULAZI nazad po čišćenju duplikata (ispravka 04.08.2026, reopen
#     061/26): uslov je da MSSQL izvor ponovo prati BigBit — proveri da
#     `SELECT MAX(PoslednjaIzmena) FROM R_Artikli` nije stariji od poslednjeg
#     .mdb drop-a (`SELECT max(file_mtime) FROM bb_mdb_drops`). Dok je izvor
#     zamrznut, artikle vozi ISKLJUČIVO noćni .mdb uvoz. Kad/ako izvor oživi,
#     prvo pokretanje ide NADGLEDANO (ručni /sync/run uz posmatranje), jer prvi
#     prolaz briše ~2.300 duplikat-grupa. PRE-CHECK (koliko živih referenci gađa redove koji NISU
#     pobednik po katbroju — mora biti 0 ili poznat, inače nastaju siročići):
#       WITH keeper AS (
#         SELECT DISTINCT ON (lower(btrim(catalog_number))) id
#           FROM items WHERE btrim(coalesce(catalog_number,'')) <> ''
#          ORDER BY lower(btrim(catalog_number)), id)
#       SELECT 'price_list_entries' AS tabela, count(*) AS pogodjenih_referenci
#         FROM price_list_entries p
#        WHERE p.item_id NOT IN (SELECT id FROM keeper)
#       UNION ALL
#       SELECT 'work_order_item_components', count(*)
#         FROM work_order_item_components w
#        WHERE w.item_id NOT IN (SELECT id FROM keeper);
BIGBIT_NIGHTLY_SYNC=

# --- Dispatch worker (Talas A-2a — src/modules/scheduler/dispatch) ---
# 'true' = 3.0 SAM prazni sy15 outbox-e (kadr/maint/pb): dequeue → mejl (Resend)
# / WhatsApp (Meta Graph) → mark_sent/mark_failed. Tri posla na */5 min.
# ODVOJEN prekidač od SCHEDULER_ENABLED namerno: enqueue (Talas A) i slanje su
# nezavisni: pogon može da radi a slanje da stoji. Oba moraju biti 'true' da bi
# se slalo; bez ovoga su dispatch poslovi no-op (debug log) — deploy je bezbedan.
# ⚠️ NE PALITI DOK STARI sy15 DISPEČER ŠALJE ISTE OUTBOX-e — nije paralelno
# bezbedno: SKIP LOCKED štiti samo claim, a prozor slanja je van brave. pb jeste
# bezbedan (claim ga prebaci u 'processing'), ali kadr/maint claim NE pomera
# next_attempt_at niti menja status → red je odmah ponovo izborljiv i drugi
# dispečer pošalje duplikat iste poruke.
# REDOSLED AKTIVACIJE (atomski preklop): 1) skini hr/maint/pb fn-ove iz
# sy15-scheduler petlje, 2) TEK ONDA DISPATCH_ENABLED=true. Gašenje = obrnuto.
# Sastanci NISU u ovom workeru — imaju svoj prekidač (odmah ispod).
DISPATCH_ENABLED=

# --- Sastanci dispatch (Talas A-2b — dispatch/sastanci-dispatch.service.ts) ---
# 'true' = 3.0 SAM prazni sy15 `sastanci_notification_log`: dequeue → render
# šablona (pozivnice, zapisnici, podsetnici, otkazivanja) → Resend → mark_sent.
# Jedan posao na */2 min (paritet stare sy15 kadence).
# ODVOJEN od DISPATCH_ENABLED namerno: sastanci se u sy15 dispatch petlji gase
# zasebnom stavkom, pa i preklop mora da bude nezavisan i atoman.
# ⚠️ NE PALITI DOK sy15 `sastanci-notify-dispatch` RADI — claim samo uveća
# attempts (next_attempt_at i status ostaju), pa je red odmah ponovo izborljiv i
# drugi dispečer pošalje DUPLU pozivnicu/zapisnik.
# REDOSLED AKTIVACIJE: 1) skini sastanci-notify-dispatch iz sy15-scheduler
# petlje, 2) TEK ONDA DISPATCH_SASTANCI_ENABLED=true. Gašenje = obrnuto.
DISPATCH_SASTANCI_ENABLED=

# Baza aplikacije za deep-linkove u sastanci mejlovima (uvek sa završnim '/').
# Prazno → pada na SY15_APP_URL, pa na https://servosync.servoteh.com/.
# ⚠️ Linkovi u mejlovima su do 25.07.2026 bili MRTVI: stari edge šablon je gradio
# `…/sastanci/<uuid>`, a 3.0 statički export nema `[id]` rute → 404. Portovani
# šabloni koriste `…/sastanci?open=<id>` i `…/sastanci?tab=podesavanja`.
PUBLIC_APP_URL=

# JAVNA baza OVOG backend-a (sa `/api` prefiksom, BEZ `/v1`). Koristi je 3.0 RSVP
# magic-link u pozivnici pod `SASTANCI_PB_IZVOR=3.0`:
#   `…/api/v1/sastanci-rsvp?t=<token>&r=dolazim` (SastanciRsvpController).
# Prazno → https://api.servosync2.servoteh.com/api (produkciona vrednost, ista koju
# front već nosi u NEXT_PUBLIC_API_URL) — preklop prekidača NE traži novo podešavanje.
#
# ⚠️ ZAŠTO NIJE PUBLIC_APP_URL: ta kaskada daje adresu FRONTA, a front i API su
# različiti hostovi (docs/infra/INFRASTRUKTURA.md §6 — front servosync2.servoteh.com
# na Cloudflare Workers, API api.servosync2.servoteh.com kroz tunel na localhost:3000).
# Worker (frontend/worker/index.ts) NE proksira `/api`, pa bi `${PUBLIC_APP_URL}api/…`
# pao na static export i vratio 404 — tj. „Dolazim / Ne dolazim" dugmad bi opet bila
# mrtva, što je baš bag koji je RSVP link već jednom imao.
PUBLIC_API_URL=

# JAVNA baza sy15 edge funkcija — koristi je RSVP magic-link u pozivnici
# (`…/functions/v1/sastanci-rsvp?t=…&r=dolazim`). Mora biti adresa dostupna SA
# INTERNETA: primalac klikće dugme iz mejla, često sa telefona van firme.
# ⚠️ I ovo je POPRAVKA, ne paritet: stari edge je link gradio iz internog
# `SUPABASE_URL` (`http://<gateway>/…`), pa su „Dolazim / Ne dolazim" dugmad bila
# mrtva za SVE primaoce. Zato se NE izvodi iz SY15_REST_URL — na produ je to LAN
# adresa (192.168.64.28:8090) i dugmad bi radila samo sa LAN-a.
# Prazno → izvodi se iz SY15_STORAGE_URL (/storage/v1 → /functions/v1; taj env je
# na produ garantovano javni gateway), pa tek onda iz SY15_REST_URL.
SY15_FUNCTIONS_URL=https://api.servosync.servoteh.com/functions/v1

# WhatsApp Cloud API (Meta Graph v20) — kanal 'whatsapp' u kadr/maint outbox-u.
# VREDNOSTI SE PRI AKTIVACIJI PREPISUJU sa sy15 functions kontejnera (Supabase
# secrets istog imena) — ovde se NE upisuju (tajne nisu u gitu). Ako bilo koja od
# prve tri fali → whatsapp redovi idu u DRY-RUN (markiraju se 'sent' da ne blokiraju
# red), identično 1.0 edge ponašanju.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_TEMPLATE_NAME=
# Jezik odobrenog template-a; default 'sr' ako je prazno.
WA_TEMPLATE_LANG=

# --- Dnevni brief (Talas AI-3 — scheduler/daily-brief.service.ts) ---
# Proaktivan jutarnji mejl direktoru/menadžmentu (~07:00, radnim danima): kašnjenja
# RN vs rok, blokirani (odbijeni) RN, zahtevi koji čekaju odluku, sastanci danas,
# odsustva danas, prijave škarta/dorade, otvorene montažne neusaglašenosti —
# RANGIRANO, sa izvorom uz svaku stavku. LLM SAMO formuliše tekst; brojevi su iz
# upita. Nivo autonomije 1–2: samo čita i šalje mejl (ne pokreće nijednu akciju).
#
# 'true' = posao se registruje i šalje. Bez ovoga se posao NE REGISTRUJE (nije u
# /scheduler/jobs, nema run-now) — deploy je bezbedan (isti obrazac kao
# BIGBIT_NIGHTLY_SYNC). Traži i SCHEDULER_ENABLED=true (pogon tika).
DAILY_BRIEF_ENABLED=
# Primaoci — zarezom razdvojeni mejlovi (direktor + menadžment krug). Svaki mora
# imati nalog u `users` (rola određuje koje sekcije vidi: RN, zahtevi-odluke,
# kadrovska-odsustva, sastanci… filtrira se po permisijama kao /me/permissions).
# Primer: nenad.jarakovic@servoteh.com,menadzment1@servoteh.com
DAILY_BRIEF_TO=
# Model za sažetak (sistemski poziv — van korisničkih budžeta). Prazno → claude-sonnet-5.
AI_DAILY_BRIEF_MODEL=

# --- Nedeljna bezbednosna provera sy15 (scheduler/security-audit.service.ts) ---
# Posao `sy15-anon-security-audit`, ponedeljak 07:15: meri da li je ijedan objekat
# u šemi `public` otvoren roli `anon` (= svako sa interneta preko PostgREST-a, bez
# prijave). Pet provera: tabele bez RLS-a, pogledi bez security_invoker, funkcije
# SECURITY DEFINER koje menjaju podatke bez provere pozivaoca, sama brana
# `sec_guard_revoke_anon`, i podrazumevana prava (pg_default_acl).
#
# NEMA prekidača namerno: posao SAMO ČITA sistemske kataloge i ćuti dok je čisto
# (bez nalaza = samo log, BEZ mejla — da nedeljni „sve u redu" ne postane šum koji
# se ignoriše). Traži SCHEDULER_ENABLED=true (pogon tika) i SY15_DATABASE_URL.
# Provera na zahtev, bez čekanja ponedeljka: GET /api/v1/scheduler/security-audit
# (permisija scheduler.read) — vraća isti strukturiran nalaz, ali NE šalje mejl.
#
# Primaoci izveštaja o nalazima — zarezom razdvojeni mejlovi.
# Prazno → nenad.jarakovic@servoteh.com (podrazumevano, da provera radi bez podešavanja).
SECURITY_AUDIT_MAIL_TO=

# ── 360° procene: javni link u pozivnici ─────────────────────────────────
# OPCIONO. Podrazumevano pozivnica vodi na NATIVNI ekran ocenjivaca u 3.0
# (`/profil?ocena=<raterId>`), a baza adrese se uzima iz iste kaskade kao za
# sastanke: PUBLIC_APP_URL -> SY15_APP_URL -> https://servosync.servoteh.com.
# Prod tu kaskadu vec ima, pa 360° pozivnice NEMAJU dodatni preduslov za deploy.
#
# Postavi OVO samo ako privremeno treba stari 1.0 link `ocena.html?token=`
# (npr. dok se 1.0 gasi). Tada mora pokazivati na host koji stvarno servira
# `ocena.html` — 3.0 static export je nema, a worker proksira na 1.0 samo
# /m, /assets, /icons i manifest, pa bi 3.0 host dao 404 i kampanja bi se tiho
# zaglavila (invited_at upisan, nijedna ocena ne stigne).
ASSESSMENT_PUBLIC_BASE=
# ── Talas AI-0: budžeti, fallback i cene (docs/PLAN_AI_OS_2026-07.md §5) ─────
# Rezerva tokena za RAZMIŠLJANJE pored budžeta odgovora. `max_tokens` je tvrd
# plafon na razmišljanje + tekst, pa bez ovoga Claude 5 generacija tiho seče
# odgovor. Prazno → 8000.
AI_THINKING_HEADROOM_TOKENS=8000

# Rezervni modeli posle iscrpljenog retry-ja (429/5xx/mrežni pad). Fallback NE
# važi za STT ni embeddings — nemaju parnjaka. Prazno → vrednosti ispod.
AI_FALLBACK_CLAUDE_MODEL=claude-haiku-4-5
AI_FALLBACK_OPENAI_MODEL=gpt-4o-mini

# Dnevni budžeti po korisniku (admin je izuzet). Izvor brojanja je `ai_usage_log`.
# chat: ULAZNI tokeni (prompt + alati + istorija + slike) — ono što stvarno košta.
AI_CHAT_DAILY_INPUT_TOKENS=200000
# STT: sekunde audija dnevno. Trajanje se izvodi iz odgovora — gpt-4o-transcribe
# vraća `usage.input_token_details.audio_tokens`, koje gateway upisuje u
# `ai_usage_log.tokens_in`; sekunde = audio_tokeni / AI_STT_AUDIO_TOKENS_PER_SECOND.
# Podrazumevanih 10 tok/s je stopa tokenizacije OpenAI gpt-4o audio familije —
# kalibriši snimkom poznate dužine (uporedi `tokens_in` sa stvarnim sekundama).
AI_STT_DAILY_SECONDS=1800
AI_STT_AUDIO_TOKENS_PER_SECOND=10
# Fallback SAMO za pozive bez `usage` u odgovoru (npr. whisper-1): sekundi po pozivu.
AI_STT_AVG_SECONDS=60
# „✨ Doteraj tekst" — broj poziva dnevno.
AI_REFINE_DAILY_CALLS=100

# Cenovnik za `ai_usage_log.est_cost_usd` u USD/1M tokena, {"model":[ulaz,izlaz]}.
# Spaja se preko ugrađene tabele; nepoznat model → cena ostaje NULL.
AI_PRICE_TABLE_JSON=

# Održavanje → AI čitanje računa iz servisa (opciono; bez njega ide podrazumevani model).
# Dozvoljeno: claude-opus-4-8 | claude-sonnet-4-6 | claude-haiku-4-5
ODRZAVANJE_RACUN_AI_MODEL=claude-sonnet-4-6

# --- Gašenje sy15, korak 1: DVA NEZAVISNA prekidača izvora ---
# docs/SEOBA_SASTANCI_PB_2026-08-05.md §7h · docs/PLAN_GASENJA_SY15_2026-08-03.md
#
# Obe promenljive primaju iste vrednosti:
#   sy15  (PODRAZUMEVANO, i za svaku neprepoznatu vrednost) = ponašanje kao i do sada.
#   3.0                                                     = prenete putanje idu u 3.0 bazu.
#
# Isti obrazac kao REVERSI_IZVOR / PROXY_1_0_AKTIVAN: preklop i POVRATAK su promena
# ove promenljive + restart (~2 min), BEZ novog deploy-a koda.
#
# 🔴 ZAŠTO SU DVA (incident 06.08.2026): do tada je postojao JEDAN zajednički
# prekidač `SASTANCI_PB_IZVOR`. Čim je na produkciji stao na `3.0` (sastanci su
# bili spremni), CEO projektni biro je počeo da vraća 503, a posao
# `pb-notify-dispatch` da pada na svaka 2 minuta — modul koji se ne seli bio je
# talac tuđeg preklopa. Pravilo za sve preostale korake (održavanje, reversi):
# JEDAN PREKIDAČ = JEDAN DOMEN; pre uvođenja proveriti da ne dodiruje tuđ domen.

# Sastanci: `sastanci*`, `akcioni_plan*`, `pm_teme*`, `presek_*`, `sast_weekly_*`.
# Pod `3.0` modul radi CEO (CRUD, samousluga, zaključavanje/arhiva, pozivnice i
# podsetnici, sedmični kolegijum, mejl kanal i dispatch, registar idempotencije).
# Sa 503 namerno ostaje samo ⭐ lista prioritetnih predmeta (nije domen sastanaka),
# a iz sy15 se READ-ONLY još čitaju `kadr_holidays` i storage bucket-i.
SASTANCI_IZVOR=sy15

# Projektni biro: `pb_*` tabele. OSTAJE `sy15` dok kadrovska ne pređe (korak 4b):
# sva prava modula izvode se iz `pb_current_employee_id()` → `employees` +
# `departments`/`sub_departments`/`job_positions`. Pod `3.0` ceo modul vraća 503 —
# to je stanje kvara, ne radno stanje. NE dirati zbog preklopa sastanaka.
PB_IZVOR=sy15

# Održavanje / CMMS: 34 `maint_*` tabele (sredstva, mašine, radni nalozi, prijave
# kvara, vozila/vozači/gume, delovi, dokumenti, obaveštenja).
# Merenje i runbook: docs/SEOBA_ODRZAVANJA_2026-08-06.md (korak 2 gašenja sy15).
#
# 🔴 OVAJ PREKIDAČ POKRIVA I TRI POTROŠAČA VAN MODULA `odrzavanje` — jer prekidač
# prati STVARNE POZIVAOCE podataka, ne naziv modula (pouka incidenta 06.08.2026):
#   • scheduler posao `maint-deadlines` i dispečer `maint-notify-dispatch`
#     (grana `dispatchMaint`; `kadr` i `pb` grane se NE diraju),
#   • pet alata AI-asistenta nad `maint_*` — presudno `prijavi_kvar`, koji radi
#     `INSERT INTO maint_incidents` (bez brane bi prijave kvara kroz asistenta
#     nastavile da idu u sy15 dok modul piše u 3.0 → dve istine o kvarovima),
#   • izveštaj mašina u REVERSIMA: `v_rev_machines` je `SELECT … FROM maint_machines`,
#     pa bi posle preklopa tiho prikazivao zastarele mašine. (Reversi se sele u
#     koraku 3 i imaće svoj `REVERSI_IZVOR` — ovo je jedina njihova tačka ovde.)
#
# STANJE 06.08.2026: podaci su spremni i prenos je dokazan (34 tabele / 764 reda,
# drugi prolaz `ins=0`), ali LOGIKA još nije prepisana — pod `3.0` sve gorenavedeno
# vraća 503 sa imenom putanje. Zato OSTAJE `sy15` do prepisa (runbook §7).
# Za razliku od projektnog biroa, održavanje NE ČEKA kadrovsku: izmereno je da
# nijedna `maint*` funkcija ne pominje `employees`/`departments`/`profiles`.
ODRZAVANJE_IZVOR=sy15

# ⚠️ ZASTARELO: `SASTANCI_PB_IZVOR` (jedan prekidač za oba domena). Ako je
# postavljen, čita ga SAMO sastanci deo — kao rezervu kad `SASTANCI_IZVOR` nije
# zadat — uz upozorenje u logu. `PB_IZVOR` ga NAMERNO ignoriše, pa stari naziv
# više ne može da obori projektni biro. Obrisati iz okruženja kad se postave nova dva.
#SASTANCI_PB_IZVOR=

# --- Gašenje sy15, korak 3: REVERSI + LOKACIJE (SPREGNUT PAR) ---
# Merenje i runbook: docs/SEOBA_REVERSI_LOKACIJE_2026-08-07.md
#
# 🔴 IZUZETAK OD PRAVILA „jedan prekidač = jedan domen": ova dva prekidača MORAJU
# imati ISTU vrednost. Backend odbija da se podigne ako se razlikuju.
#
# Pravilo iz 06.08.2026 nastalo je zato što su sastanci i PB bili NEPOVEZANI domeni
# pod jednim prekidačem, pa je spreman obarao nespreman. Reversi i Lokacije su
# suprotan slučaj — TRANSAKCIONO SU SPOJENI (izmereno 07.08.2026 nad produkcijom):
#   • `rev_issue_reversal` / `rev_confirm_return` u ISTOM COMMIT-u pišu
#     `rev_document_lines` I `loc_location_movements` (kroz `loc_create_movement`),
#   • `rev_document_lines.issue_movement_id` → `loc_location_movements`: 40 redova,
#   • `rev_tools.loc_item_ref_id` ↔ `loc_item_placements`: 47/47,
#   • `rev_documents.recipient_loc_id` → `loc_locations`: 27/27 (nijedan NULL).
# Razdvojen preklop ne obara modul — on TIHO preseca jednu transakciju na dve baze.
# Zato svaki domen ima SVOJE ime (poruke o 503 imenuju domen koji je zapeo), ali
# je neslaganje vrednosti greška pri podizanju, a ne stanje u kome se radi.
#
# Reversi: 14 `rev_*` tabela (alat, rezni alat, dokumenti izdavanja, inventar).
REVERSI_IZVOR=sy15

# 🔴 Lokacije: 7 `loc_*` tabela. NAJHITNIJI DOMEN CELE SEOBE — jedini u koji
# korisnici UŽIVO pišu u sy15 (izmereno u `loc_location_movements`: 05.08=14,
# 06.08=3, 07.08=13 upisa, sa mobilne i sa skenera). Svaki dan odlaganja je dan
# sa dva izvora istine. NE pokriva `part-locations` (2.0-native QBigTehn ledger,
# slično ime, drugi domen).
LOKACIJE_IZVOR=sy15

# ⚠️ Izuzetak koji ukida gornju spregu. Postoji SAMO da razdvajanje bude imenovana
# odluka, nikad previd. Pod `true` backend se podiže i sa različitim vrednostima,
# uz upozorenje u logu — a izdavanje alata piše u DVE baze. Ne koristiti na produkciji.
#REVERSI_LOKACIJE_RAZDVOJENO=false

# STANJE 07.08.2026: šema i prenos SU spremni (21 tabela / 5.659 redova; prenos
# idempotentan, dokazan na probnoj bazi — dva uzastopna `--apply` daju isti broj
# redova i sva 4 rev↔loc šava se poklapaju). LOGIKA nije prepisana: `rev_issue_reversal`
# i `rev_confirm_return` su cela poslovna logika u PL/pgSQL-u, u TypeScript-u je NEMA
# (runbook §4, procena 5–8 dana). Zato OBE promenljive OSTAJU `sy15`.
